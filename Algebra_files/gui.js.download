            let savedata={equation:eq.equation,historytext:eq.history.text,historyeq:eq.history.eq};
            let filename=new Date().toISOString().split(".")[0].replaceAll(":","")+'.json';
            var dataStr = "data:text/json;charset=utf-8,"+encodeURIComponent(JSON.stringify(savedata));
            const link = document.createElement('a');
            link.href = dataStr;
            link.download = filename;
            document.body.appendChild(link); // Append to the body (optional, but good practice)
