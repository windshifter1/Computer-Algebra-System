        btnload.innerHTML='LOAD';
        btnload.onclick=()=>{
            document.getElementById('fileInput').click();
        };
        btnload.style.margin='0px 20px 0px 0px';
        container.appendChild(btnload);
        document.getElementById('fileInput').addEventListener('change', function(event) {
            const files = event.target.files; // Get the FileList object
            if (files.length > 0) {
                const selectedFile = files[0];
                const reader=new FileReader();
                reader.onload=(e)=>{
                    const fileContent = e.target.result;
                    try{
                        const data=JSON.parse(fileContent);
                        while(eq.history.text.length>0){
                            eq.history.undo(eq);
                        }
                        for(let i=0;i<data.historytext.length;i++){
                            eq.history.addelement(data.historytext[i],data.historyeq[i]);
                        }
                        eq.equation=data.equation;
                        eq.sortanddraw();
