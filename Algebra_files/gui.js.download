                        input.value=input.value.substring(0,pos)+elowercase[i]+input.value.substring(pos,input.value.length);
                        input.focus();
                        input.selectionStart=pos+1;
                        input.selectionEnd=pos+1;
                        input.oninput(idinput,iderror,idlatex);
                    }
                    ec.appendChild(btn);
                }
            }
            input.focus();
        };
        shiftbtn.click();
