                        input.focus();
                        input.selectionStart=pos+1;
                        input.selectionEnd=pos+1;
                        input.oninput(idinput,iderror,idlatex);
                    }
                    gc.appendChild(btn);
                }
                while(ec.firstChild){
                    ec.removeChild(ec.firstChild);
                }
                for(let i=0;i<euppercase.length;i++){
                    const btn=document.createElement('button');
                    btn.style.touchAction='none';
                    btn.innerHTML=euppercase[i];
                    if(i===euppercase.length-1){
                        btn.style.margin='0px 20px 0px 0px';
                    }
                    btn.onclick=()=>{
                        let pos=input.selectionStart;
                        input.value=input.value.substring(0,pos)+euppercase[i]+input.value.substring(pos,input.value.length);
                        input.focus();
                        input.selectionStart=pos+1;
                        input.selectionEnd=pos+1;
                        input.oninput(idinput,iderror,idlatex);
                    }
                    ec.appendChild(btn);
                }
            }else{
                shiftbtn.value='off';
                shiftbtn.style.backgroundColor=shiftnotcolor;
                while(gc.firstChild){
                    gc.removeChild(gc.firstChild);
                }
                for(let i=0;i<glowercase.length;i++){
                    const btn=document.createElement('button');
                    btn.style.touchAction='none';
                    btn.innerHTML=glowercase[i];
                    if(i===glowercase.length-1){
                        btn.style.margin='0px 20px 0px 0px';
                    }
                    btn.onclick=()=>{
                        let pos=input.selectionStart;
                        input.value=input.value.substring(0,pos)+glowercase[i]+input.value.substring(pos,input.value.length);
                        input.focus();
                        input.selectionStart=pos+1;
                        input.selectionEnd=pos+1;
                        input.oninput(idinput,iderror,idlatex);
                    }
                    gc.appendChild(btn);
                }
                while(ec.firstChild){
                    ec.removeChild(ec.firstChild);
                }
                for(let i=0;i<elowercase.length;i++){
                    const btn=document.createElement('button');
                    btn.style.touchAction='none';
                    btn.innerHTML=elowercase[i];
                    if(i===elowercase.length-1){
                        btn.style.margin='0px 20px 0px 0px';
                    }
                    btn.onclick=()=>{
