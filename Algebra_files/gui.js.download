}
var keyboardstate=0;
function showhideelement(id) {
    keyboardstate=(keyboardstate+1)%4
    var x=document.getElementById(id);
    if (keyboardstate<3) {
        onscreenkeyboard('keyboard',"input","errors",'inputdisplay');
        x.style.display="block";
    } else {
        hide()
        x.style.display = "none";
    }
    document.getElementById('container').scrollTo(document.getElementById('container').scrollLeft,document.getElementById('container').scrollHeight);
}

function addtypesettext(text,id){
    typeset(()=>{
        const inputmathdisplay = document.querySelector('#'+id);
        inputmathdisplay.innerHTML=text;
        return inputmathdisplay;
    });
}

function typeset(code) {
    MathJax.texReset();
    MathJax.startup.promise = MathJax.startup.promise.then(() => {code();return MathJax.typesetPromise()}).then(()=>{
        document.getElementById('container').scrollTo(document.getElementById('container').scrollLeft,document.getElementById('container').scrollHeight);
    }).catch((err) => console.log('Typeset failed: ' + err.message));
    return MathJax.startup.promise;
}

class horozontaldragscroll{
    mouseDown=false;
    startX;
    scrollLeft;
    container;
    stopclick=false;
    constructor(container){
        this.container=container;
        let startDragging=(e)=>{
            this.mouseDown = true;
            this.startX=e.pageX-this.container.offsetLeft;
            this.scrollLeft=this.container.scrollLeft;
        };
        let stopDragging=(event)=>{
            this.mouseDown = false;
            if(this.stopclick){
                tempdisableallclick();
            }
            this.stopclick=false;
        };
        this.container.addEventListener('pointermove', (e) => {
            e.preventDefault();
            if(!this.mouseDown) {
                return;
            }
            const x = e.pageX - this.container.offsetLeft;
            const scroll = x - this.startX;
            this.container.scrollLeft = this.scrollLeft - scroll;
            if(Math.abs(scroll)>10){
                this.stopclick=true;
            }
        });
        this.container.addEventListener('pointerdown',startDragging, false);
        this.container.addEventListener('pointerup',stopDragging, false);
        this.container.addEventListener('pointerleave',stopDragging, true);
    }
}
class equationhistory{
    text=[];
    textnode=[];
    image=[];
    eq=[];
    textredo=[];
    textredonode=[];
    imageredo=[];
    eqredo=[];
    addelement(message,equ){
        var node = document.getElementById('history');

        this.textredo.splice(0,this.textredo.length);
        this.textredonode.splice(0,this.textredonode.length);
        this.imageredo.splice(0,this.imageredo.length);
        this.eqredo.splice(0,this.eqredo.length);

        var neweqimage = document.createElement('canvas');
        neweqimage.id='equation'+this.image.length;
        neweqimage.style.touchAction="none";
        node.appendChild(neweqimage);
        var eq=new equation();
        eq.equation=equ;
        eq.canvasid=neweqimage.id;
        eq.printimage(eq.equation);
        eq.sortanddraw();
        eq.copyevents();
        this.image.push(neweqimage);
        this.eq.push(equ);

        var newtext = document.createElement('div');
        newtext.id='equationtext'+this.image.length;
        node.appendChild(newtext);
        this.textnode.push(newtext);
        this.text.push(message);
        addtypesettext(message,newtext.id);
    }
    undo(equ){
        var node = document.getElementById('history');
        if(this.image.length>0){
            var remimage=this.image.pop();
            this.imageredo.push(remimage);
            node.removeChild(remimage);
            
            var remtext=this.text.pop();
            var remtextnode=this.textnode.pop()
            this.textredo.push(remtext);
            this.textredonode.push(remtextnode);
            node.removeChild(remtextnode);

            this.eqredo.push(equ.equation);
            equ.equation=this.eq.pop();
            equ.sortanddraw();
        }else if(equ.equation!==''){
            this.imageredo.push('');
            this.textredo.push('');
            this.textredonode.push('');
            this.eqredo.push(equ.equation);
            equ.equation='';
            equ.sortanddraw();
        }
    }
    redo(equ){
        var node = document.getElementById('history');
        if(this.imageredo.length>0){
            var req=this.eqredo.pop();
            this.eq.push(equ.equation);
            equ.equation=req;
            equ.sortanddraw();
            
            var im=this.imageredo.pop();
            if(im!==''){
                this.image.push(im);
                node.appendChild(im);
            }
            
            var message=this.textredo.pop();
            var messagenode=this.textredonode.pop();
            if(im!==''){
                this.text.push(message);
                this.textnode.push(messagenode);
                node.appendChild(messagenode);
            }
        }
    }
}