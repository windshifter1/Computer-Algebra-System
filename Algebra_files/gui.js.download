
var scrolltimer=null;
function ein(){
    document.getElementById('input').disabled=false;
    document.getElementById('input').addEventListener('paste',pastemodify);
};
window.onresize=()=>{
    document.getElementById("viewwindow").style.height=(window.innerHeight-10*window.devicePixelRatio)+'px';
    // onscreenkeyboard('keyboard',"input","errors",'inputdisplay');
};
function tempdisableallclick(){
    var h=(e)=>{
        e.stopPropagation();
        e.preventDefault();
    }
    document.addEventListener('click',h,true);
    setTimeout(()=>{document.removeEventListener('click',h,true);},150);
}
