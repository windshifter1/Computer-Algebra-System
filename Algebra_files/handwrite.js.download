function dotprodline(x,y,start,mid,end){
    let v1=[x[mid]-x[start],y[mid]-y[start]];
    let v2=[x[end]-x[mid],y[end]-y[mid]];
    let v1dotv2=(v1[0]*v2[0]+v1[1]*v2[1])/Math.sqrt((v1[0]*v1[0]+v1[1]*v1[1])*(v2[0]*v2[0]+v2[1]*v2[1]));
    return [v1dotv2,v1,v2];
}
function linspace(start,end,points=100){
    if(points===1){
        return [start];
    }
    let range=end-start;
    let x=[];
    let stepsize=range/(points-1);
    for(let i=0;i<points;i++){
        x[i]=start+i*stepsize;
    }
    return x;
}
function centroidarea(x,y){
    let A=0;
    let cx=0;
    let cy=0;
    for(let i=0;i<x.length-1;i++){
        A+=x[i]*y[i+1]-x[i+1]*y[i];
        cx+=(y[i+1]-y[i])*(x[i+1]*x[i+1]+x[i+1]*x[i]+x[i]*x[i]);
        cy+=(x[i]-x[i+1])*(y[i+1]*y[i+1]+y[i+1]*y[i]+y[i]*y[i]);
    }
    let i=x.length-1;
    cx+=(y[0]-y[i])*(x[0]*x[0]+x[0]*x[i]+x[i]*x[i]);
    cy+=(x[i]-x[0])*(y[0]*y[0]+y[0]*y[i]+y[i]*y[i]);
    A+=x[i]*y[0]-x[0]*y[i];
    cx=cx/6;
    cy=cy/6;
    A=A/2;
    cx=cx/A;
    cy=cy/A;
    return [cx,cy,A]
}
function area(x,y){
    let A=0;
    for(let i=0;i<x.length-1;i++){
        A+=x[i]*y[i+1]-x[i+1]*y[i];
    }
    let i=x.length-1;
    A+=x[i]*y[0]-x[0]*y[i];
    A=A/2;
    return A;
}
function dist2intersect(x,y,ang,points){
    let dp=Number.POSITIVE_INFINITY;
    let dn=Number.NEGATIVE_INFINITY;
    let pi=-1;
    let ni=-1;
    for(let i=0;i<points.x.length-1;i++){
        if(!Number.isFinite(points.x[i+1])||!Number.isFinite(points.x[i]))continue;
        let vx=points.x[i+1]-points.x[i];
        let vy=points.y[i+1]-points.y[i];
        let sinang=Math.sin(ang);
        let cosang=Math.cos(ang);
        let det=-vx*sinang+cosang*vy;
        let vcx=x-points.x[i];
        let vcy=y-points.y[i];
        let pathintersect=(-sinang*vcx+cosang*vcy)/det;
        if(pathintersect>=0&&pathintersect<=1){
            let rayintersect=(-vy*vcx+vx*vcy)/det;
            if(rayintersect>0&&rayintersect<dp){
                dp=rayintersect;
                pi=i;
            }else if(rayintersect<0&&rayintersect>dn){
                dn=rayintersect;
                ni=i;
            }
        }
    }
    return [dp,dn,pi,ni];
}
function intersectloc(p1start,p1end,p2start,p2end){
    let vp1=[p1end[0]-p1start[0],p1end[1]-p1start[1]];
    let vp2=[p2end[0]-p2start[0],p2end[1]-p2start[1]];
    let M=[[vp1[0],-vp2[0]],[vp1[1],-vp2[1]]];
    let Y=[[-p1start[0]+p2start[0]],[-p1start[1]+p2start[1]]];
    let X=mtimes(inv(M),Y);
    return [X[0][0]>=0&&X[0][0]<=1&&X[1][0]>=0&&X[1][0]<=1,[vp1[0]*X[0][0]+p1start[0],vp1[1]*X[0][0]+p1start[1]],[vp2[0]*X[1][0]+p2start[0],vp2[1]*X[1][0]+p2start[1]]];
}
function mindistbetween(p1,p2){
    let mindist=Number.POSITIVE_INFINITY;
    for(let i=0;i<p1.x.length-1;i++){
        for(let ii=0;ii<p2.x.length-1;ii++){
            if(isFinite(p1.x[i])&&isFinite(p2.x[ii])){
                let distbetweenpoints=((p1.x[i]-p2.x[ii])**2+(p1.y[i]-p2.y[ii])**2)**.5;
                if(Number.isFinite(distbetweenpoints)&&distbetweenpoints<mindist){
                    mindist=distbetweenpoints;
                }
            }
            if(isFinite(p1.x[i])&&isFinite(p1.x[i+1])&&isFinite(p2.x[ii])&&isFinite(p2.x[ii+1])){
                let vp1=[p1.x[i+1]-p1.x[i],p1.y[i+1]-p1.y[i]];
                if(vp1[0]===0&&vp1[1]===0){
                    continue
                }
                let vp2=[p2.x[ii+1]-p2.x[ii],p2.y[ii+1]-p2.y[ii]];
                if(vp2[0]===0&&vp2[1]===0){
                    continue
                }
                if(Math.abs(vp1[0]*vp2[0]+vp1[1]*vp2[1])/Math.sqrt((vp1[0]*vp1[0]+vp1[1]*vp1[1])*(vp2[0]*vp2[0]+vp2[1]*vp2[1]))===1){
                    continue
                }
                let M=[[vp1[0],-vp2[0]],[vp1[1],-vp2[1]]];
                let Y=[[-p1.x[i]+p2.x[ii]],[-p1.y[i]+p2.y[ii]]];
                let X=mtimes(inv(M),Y);
                let intloc=[vp1[0]*X[0][0]+p1.x[i],vp1[1]*X[0][0]+p1.y[i]];
                //let intloc=[vp2[0]*X[1][0]+p2.x[ii],vp2[1]*X[1][0]+p2.y[ii]];
                if(X[0][0]>=0&&X[0][0]<=1&&X[1][0]>=0&&X[1][0]<=1){
                    return 0;
                }else if(X[0][0]>=0&&X[0][0]<=1){
                    let dist=Math.sqrt(Math.pow(intloc[0]-(X[1][0]>=0?p2.x[ii+1]:p2.x[ii]),2)+Math.pow(intloc[1]-(X[1][0]>=0?p2.y[ii+1]:p2.y[ii]),2));
                    if(dist<mindist){
                        mindist=dist;
                    }
                }else if(X[1][0]>=0&&X[1][0]<=1){
                    let dist=Math.sqrt(Math.pow(intloc[0]-(X[0][0]>=0?p1.x[i+1]:p1.x[i]),2)+Math.pow(intloc[1]-(X[0][0]>=0?p1.y[i+1]:p1.y[i]),2));
                    if(dist<mindist){
                        mindist=dist;
                    }
                }
            }
        }
    }
    let distbetweenpoints=((p1.x.at(-1)-p2.x.at(-1))**2+(p1.y.at(-1)-p2.y.at(-1))**2)**.5;
    if(Number.isFinite(distbetweenpoints)&&distbetweenpoints<mindist){
        mindist=distbetweenpoints;
    }
    return mindist
}
function inpolygon(x,y,xb,yb){
    xb=[...xb,xb[0]];
    yb=[...yb,yb[0]];
    let crosstimes=0;
    for(let i=0;i<xb.length;i++){
        let M=[[xb[(i+1)%xb.length]-xb[i],-1],[yb[(i+1)%yb.length]-yb[i],0]];
        let detM=M[0][0]*M[1][1]-M[0][1]*M[1][0];
        if(detM!==0){
            let st=mtimes(inv(M),[[x-xb[i]],[y-yb[i]]]);
            if(st[1][0]>0&&st[0][0]>=0&&st[0][0]<1){
                crosstimes++;
            }
        }
    }
    var inp=crosstimes%2===1;
    // let xx=[x,...xb];
    // let yy=[y,...yb];
    // let h=convexhull(xx,yy);
    // var inp=!h.flat().includes(0);
    // console.log(crosstimes%2===1,!h.flat().includes(0))
    return inp;
}


function eye(n){
    let I=[];
    for(var i=0;i<n;i++){
        I[i]=[];
        for(var j=0;j<n;j++){
        if(i==j){
            I[i][j]=1;
        }else{
            I[i][j]=0;
        }
    }
}
return I;
}
function mtimes(a,b){
    var m=a.length;
    var n=a[0].length;
    var p=b.length;
    var q=b[0].length;
    if(n!=p){
        throw m+" by "+n+" matrix can not be multiplied with "+p+" by "+q+" matrix.";
    }
    var c=new Array(m);
    for(var i=0;i<m;i++){
        c[i]=new Array(q).fill(0);
        for(var j=0;j<q;j++){
            for (var k=0;k<n;k++){
                c[i][j]+=a[i][k]*b[k][j];
            }
        }
    }
    return c;
}
function inv(A){
    let n=A.length;
    let I=eye(n);
    let M=[]
    for(let i=0;i<n;i++){
        M[i]=[...[A[i],I[i]].flat()];
    }
    for(let i=0;i<n;i++){
        let t=M.map((v)=>v[i]).slice(i);
        let iii=Array.from(t.keys()).sort((a,b)=>Math.abs(t[b])-Math.abs(t[a]));
        let tM=[];
        for(let ii=i;ii<n;ii++){
            tM[ii]=M[iii[ii-i]+i];
        }
        for(let ii=i;ii<n;ii++){
            M[ii]=tM[ii];
        }
        if(M[i][i]!==0){
            let inv=1/M[i][i];
            for(let ii=0;ii<2*n;ii++){
                M[i][ii]=M[i][ii]*inv;
            }
        }
        for(let ii=i+1;ii<n;ii++){
            if(M[ii][i]===0){
                continue
            }
            for(let iii=2*n-1;iii>=i;iii--){
                M[ii][iii]=M[ii][iii]-M[ii][i]*M[i][iii];
            }
        }
    }
    for(let i=n-1;i>=0;i--){
        for(let ii=i-1;ii>=0;ii--){
            for(let iii=2*n-1;iii>=i;iii--){
                M[ii][iii]=M[ii][iii]-M[ii][i]*M[i][iii];
            }
        }
    }
    let N=[];
    for(let i=0;i<n;i++){
        for(let ii=0;ii<n;ii++){
            if(ii===0){
                N[i]=[];
            }
            N[i][ii]=M[i][ii+n];
        }
    }
    return N;
}
function transpose(A){return A[0].map((col,i)=>A.map(row=>row[i]));}

function convexhull(x,y){
    let xmini=x.reduce((pv,cv,ci,array)=>cv<array[pv]?ci:pv,0);
    let xmaxi=x.reduce((pv,cv,ci,array)=>cv>array[pv]?ci:pv,0);
    let ymini=y.reduce((pv,cv,ci,array)=>cv<array[pv]?ci:pv,0);
    let ymaxi=y.reduce((pv,cv,ci,array)=>cv>array[pv]?ci:pv,0);
    let mmx=x[xmaxi]-x[xmini];
    let mmy=y[ymaxi]-y[ymini];
    if(mmx==0||mmy==0){
        Error("convexhull: Difference between minimum and maximum point equals zero");
    }
    var face1=[[...new Set([xmini,ymini,xmaxi,ymaxi])]];
    while(face1[0].length>2){
        face1[0].pop();
    }
    let n=[y[face1[0][1]]-y[face1[0][0]],-x[face1[0][1]]+x[face1[0][0]]];
    let dist=[];
    for(let i=0;i<x.length;i++){
        dist[i]=Math.abs((x[i]-x[face1[0][0]])*n[0]+(y[i]-y[face1[0][0]])*n[1]);
    }
    let fp=dist.reduce((pv,cv,ci,array)=>cv>array[pv]?ci:pv,0);
    let h=[face1[0],[face1[0][0],fp],[face1[0][1],fp]];
    for(let i=0;i<h.length;i++){
        h[i].sort((a,b)=>a-b);
    }
    let N=x.length;
    for(let j=0;j<N;j++){
        let meanxy=[0,0];
        let verts=[...new Set(h.flat())];
        for(let i=0;i<verts.length;i++){
            meanxy[0]+=x[verts[i]];
            meanxy[1]+=y[verts[i]];
        }
        meanxy[0]/=verts.length;
        meanxy[1]/=verts.length;
        let n=[];
        let a=[];
        let na=[];
        for(let i=0;i<h.length;i++){
            n.push([y[h[i][1]]-y[h[i][0]],-x[h[i][1]]+x[h[i][0]]]);
            let nn=Math.sqrt(n[i][0]*n[i][0]+n[i][1]*n[i][1]);
            n[i][0]/=nn;
            n[i][1]/=nn;
            a[i]=[x[h[i][0]],y[h[i][0]]];
            if((meanxy[0]-a[i][0])*n[i][0]+(meanxy[1]-a[i][1])*n[i][1]>0){
                n[i][0]*=-1;
                n[i][1]*=-1;
            }
            na[i]=n[i][0]*a[i][0]+n[i][1]*a[i][1];
        }
        
        let nxy=[];
        for(let i=0;i<N;i++){
            let nxyc=[]
            for(let ii=0;ii<n.length;ii++){
                nxyc[ii]=n[ii][0]*x[i]+n[ii][1]*y[i]-na[ii];
            }
            nxy[i]=nxyc;
        }
        let mdi=[];
        let md=[];
        for(let i=0;i<na.length;i++){
            mdi[i]=nxy.map(x=>x[i]).reduce((pv,cv,ci,array)=>cv>array[pv]?ci:pv,0);
            md[i]=nxy.map(x=>x[i])[mdi[i]];
        }
        let cfi=md.reduce((pv,cv,ci,array)=>cv>array[pv]?ci:pv,0);
        let cf=md[cfi];
        if(cf>1e-12){
            let fromeyev=[];
            for(let i=0;i<N;i++){
                fromeyev[i]=[x[i]-x[mdi[cfi]],y[i]-y[mdi[cfi]]];
            }
            let remfaces=[];
            let seefaces=[];
            for(let i=0;i<h.length;i++){
                if((fromeyev[h[i][0]][0]*n[i][0]+fromeyev[h[i][0]][1]*n[i][1]<0)+(fromeyev[h[i][1]][0]*n[i][0]+fromeyev[h[i][1]][1]*n[i][1]<0)==2){
                    remfaces.push(i);
                    seefaces.push(h[i]);
                };
            }
            let newfaces=[];
            for(let k=0;k<seefaces.length;k++){
                newfaces.push([seefaces[k][0],mdi[cfi]]);
                newfaces.push([mdi[cfi],seefaces[k][1]]);
            }
            for(let i=0;i<newfaces.length;i++){
                newfaces[i].sort((a,b)=>a-b);
            }
            for(let i=0;i<newfaces.length;i++){
                for(let ii=i+1;ii<newfaces.length;ii++){
                    if(newfaces[i][0]==newfaces[ii][0]&&newfaces[i][1]==newfaces[ii][1]){
                        newfaces.splice(ii,1);
                    }
                }
            }
            for(let i=h.length-1;i>=0;i--){
                for(let ii=0;ii<remfaces.length;ii++){
                    if(i==remfaces[ii]){
                        h.splice(i,1);
                    }
                }
            }
            h.push(...newfaces);
        }else{
            break
        }
    }
    return h;
}
