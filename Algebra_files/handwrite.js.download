for(let i=0;i<i2letter.length;i++){
    let row=document.createElement('div');
    row.textContent=i2letter[i];
    row.style.padding='12px 16px';
    row.style.cursor='pointer';
    row.style.transition = 'background 0.2s';
    row.style.backgroundColor=i%2===0?'#ffffff':'#aaaaaa';
    row.addEventListener('mouseenter', () => row.style.backgroundColor='#00ff00');
    row.addEventListener('mouseleave', () => row.style.backgroundColor=i%2===0?'#ffffff':'#aaaaaa');
    row.addEventListener('click',async()=>{
        if(addtotrainingcb.checked&&nninfomodify.length>0){
            let trainingdata=await compressedlocalstorage2obj("trainingdata");//JSON.parse(localStorage.getItem('trainingdata'));
            trainingdata.push([i2letter[i],nninfomodify[0],nninfomodify[2]]);
            await obj2compressedlocalstorage("trainingdata",trainingdata);//localStorage.setItem("trainingdata",JSON.stringify(trainingdata));
        }
        console.log(i2letter[i]);
        letters[lettertomodifyindex].letter=i2letter[i];
        lettertomodifyindex=-1;
        nninfomodify=[];
        fixletteroverlay.style.visibility="hidden";
        letters2eq();
    });
    chooseletterdiv.appendChild(row);
}
const trainbutton=document.createElement('button');
trainbutton.textContent='Train';
trainbutton.addEventListener('click',async()=>{
    console.log('Training');
    let wb=await compressedlocalstorage2obj('wb');
    let trainingdata=await compressedlocalstorage2obj('trainingdata');
    workerque.addTask({
        mainfunction:'trainnn',
        stringcode:`({
        trainnn:${trainnn.toString().replaceAll("transpose","this.transpose").replaceAll("classifiertraining","this.classifiertraining").replaceAll("getinputfornn","this.getinputfornn")},
        getinputfornn:${getinputfornn.toString().replaceAll("convexhull","this.convexhull").replaceAll("area","this.area").replaceAll("inpolygon","this.inpolygon").replaceAll("getpropfrompoint","this.getpropfrompoint").replaceAll("dist2intersect","this.dist2intersect")},
        convexhull:${convexhull.toString()},
        area:${area.toString()},
        inpolygon:${inpolygon.toString().replaceAll("mtimes","this.mtimes").replaceAll("inv","this.inv")},
        mtimes:${mtimes.toString()},
        inv:${inv.toString().replaceAll("eye","this.eye")},
        eye:${eye.toString()},
        getpropfrompoint:${getpropfrompoint.toString().replaceAll("linspace","this.linspace").replaceAll("dist2intersect","this.dist2intersect").replaceAll("centroidarea","this.centroidarea")},
        linspace:${linspace.toString()},
        dist2intersect:${dist2intersect.toString()},
        centroidarea:${centroidarea.toString()},
        transpose:${transpose.toString()},
        classifiertraining:${classifiertraining.toString().replaceAll("mtimes","this.mtimes").replaceAll("transpose","this.transpose").replaceAll("dsigmoid","this.dsigmoid").replaceAll("dsoftmax","this.dsoftmax").replaceAll(new RegExp(`(?<![d])sigmoid`, 'g'),"this.sigmoid").replaceAll(new RegExp(`(?<![d])softmax`, 'g'),"this.softmax")},
        dsigmoid:${dsigmoid.toString()},
        dsoftmax:${dsoftmax.toString()},
        sigmoid:${sigmoid.toString()},
        softmax:${softmax.toString()},
        })`,
        args:['train',wb,trainingdata,i2letter,1000],
    });
});
const downloadbutton=document.createElement('button');
downloadbutton.textContent='Download';
downloadbutton.addEventListener('click', async ()=>{
    let wb=await compressedlocalstorage2obj('wb');//localStorage.getItem('wb');
    let wbblob=new Blob([JSON.stringify(wb)]);
    let trainingdata=await compressedlocalstorage2obj('trainingdata');//localStorage.getItem('trainingdata');
    let tblob=new Blob([JSON.stringify(trainingdata)]);
    if(testingnn){
        let stream=wbblob.stream();
        let compressedStream = stream.pipeThrough(new CompressionStream('gzip'));
        let compressedResponse = new Response(compressedStream);
        wbblob = await compressedResponse.blob();
        stream=tblob.stream();
        compressedStream = stream.pipeThrough(new CompressionStream('gzip'));
        compressedResponse = new Response(compressedStream);
        tblob = await compressedResponse.blob();
        fetch('http://192.168.4.23:9183',{
            method:'POST',
            headers:{
                'Filename':'neuralnetwb',
            },
            body:wbblob,
        });
        fetch('http://192.168.4.23:9183',{
            method:'POST',
            headers:{
                'Filename':'neuralnettraining',
            },
            body:tblob,
        });
    }else{
        let a=document.createElement("a");
        a.href=URL.createObjectURL(wbblob);
        a.download='neuralnetwb'+(new Date().getTime())+'.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
        a=document.createElement("a");
        a.href=URL.createObjectURL(tblob);
        a.download='neuralnettraining'+(new Date().getTime())+'.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
    }
});
const restordefaultbutton=document.createElement('button');
restordefaultbutton.textContent='Restore Defaults';
restordefaultbutton.addEventListener('click',()=>{
    localStorage.removeItem("wb");
    localStorage.removeItem("trainingdata");
    loadwb().then(async ()=>{
        let trainingdata=await compressedlocalstorage2obj('trainingdata');//JSON.parse(localStorage.getItem('trainingdata'));
        function main(trainingdata,messager){
            for(let i=0;i<trainingdata.length;i++){
                trainingdata[i][1]=this.getinputfornn(trainingdata[i][2])[0];
                messager.postMessage({status:"update",progress:`Restored example ${(i+1).toString()} of ${trainingdata.length.toString()}.`});
            }
            return trainingdata;
        }
        workerque.addTask({
            mainfunction:'main',
            stringcode:`({
            main:${main.toString()},
            getinputfornn:${getinputfornn.toString().replaceAll("convexhull","this.convexhull").replaceAll("area","this.area").replaceAll("inpolygon","this.inpolygon").replaceAll("getpropfrompoint","this.getpropfrompoint").replaceAll("dist2intersect","this.dist2intersect")},
            convexhull:${convexhull.toString()},
            area:${area.toString()},
            inpolygon:${inpolygon.toString().replaceAll("mtimes","this.mtimes").replaceAll("inv","this.inv")},
            mtimes:${mtimes.toString()},
            inv:${inv.toString().replaceAll("eye","this.eye")},
            eye:${eye.toString()},
            getpropfrompoint:${getpropfrompoint.toString().replaceAll("linspace","this.linspace").replaceAll("dist2intersect","this.dist2intersect").replaceAll("centroidarea","this.centroidarea")},
            linspace:${linspace.toString()},
            dist2intersect:${dist2intersect.toString()},
            centroidarea:${centroidarea.toString()},
            })`,
            args:['restore default',trainingdata],
        });
    });
});
const loadnnfromfile=document.createElement('button');
loadnnfromfile.textContent="Load Model";
loadnnfromfile.addEventListener('click',async ()=>{
    const wb=await readuserfile();
    let good=false;
    if(Object.hasOwn(wb,"w")&&Object.hasOwn(wb,"b")){
        good=wb.b.at(-1).length===i2letter.length&&wb.w.at(-1).length===i2letter.length&&wb.w[0][0].length===45&&wb.b[0][0].length===1;
        for(let i=0;i<wb.w.length;i++){
            good&=wb.w[i].length===wb.b[i].length;
            if(i<wb.w.length-1){
                good&=wb.w[i].length===wb.w[i+1][0].length;
            }
        }
    }
    if(good){
        await obj2compressedlocalstorage('wb',wb);
        progressmessages.innerHTML="Model loaded.";
    }else{
        progressmessages.innerHTML="Model not in the correct format.";
    }
});
const loadtrainingfromfile=document.createElement('button');
loadtrainingfromfile.textContent="Load Training Data";
loadtrainingfromfile.addEventListener('click',async()=>{
    const trainingdata=await readuserfile();
    let good=false;
    if(Array.isArray(trainingdata)&&trainingdata[0].length===3){
        if(i2letter.includes(trainingdata[0][0])&&trainingdata[0][1].length===45&&Object.hasOwn(trainingdata[0][2],"x")&&Object.hasOwn(trainingdata[0][2],"y")){
            good=true;
        }
        for(let i=1;i<trainingdata.length;i++){
            if(!(i2letter.includes(trainingdata[i][0])&&trainingdata[i][1].length===45&&Object.hasOwn(trainingdata[i][2],"x")&&Object.hasOwn(trainingdata[i][2],"y"))){
                good=false;
            }
        }
    }
    if(good){
        obj2compressedlocalstorage('trainingdata',trainingdata);
        progressmessages.innerHTML="Training data Loaded.";
    }else{
        progressmessages.innerHTML="Training data not in the correct format.";
    }
});
