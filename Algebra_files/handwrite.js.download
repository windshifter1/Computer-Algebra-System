let portraitheight;
let landscapeheight;
if(screen.orientation.type.startsWith("portrait")){
    portraitheight=window.outerHeight;
}else{
    landscapeheight=window.outerHeight;
}
slider.height=5*window.devicePixelRatio;
buttonwrite.style.fontSize="10px"
buttonwrite.addEventListener('click', () => {
    if(buttonwrite.innerHTML==="✍✓"){
        buttonwrite.innerHTML="&#9997;&cross;"
        canvas.removeEventListener('pointerdown', pointerDown);
        canvas.removeEventListener('pointermove',pointerMove);
        canvas.removeEventListener('pointerup',pointerUp);

        canvas.addEventListener('pointerdown',gesturedown);
        canvas.addEventListener('pointermove',gesturemove);
        canvas.addEventListener('pointerup',gestureup);
    }else{
        buttonwrite.innerHTML="&#9997;&check;"
        canvas.addEventListener('pointerdown', pointerDown);
        canvas.addEventListener('pointermove', pointerMove);
        canvas.addEventListener('pointerup', pointerUp);

        canvas.removeEventListener('pointerdown',gesturedown);
        canvas.removeEventListener('pointermove',gesturemove);
        canvas.removeEventListener('pointerup',gestureup);
    }
});
slider.addEventListener('pointerleave',function(event){isdrawing=false;event.preventDefault();})
slider.addEventListener("touchstart",function(event) {event.preventDefault()})
slider.addEventListener("touchmove",function(event) {event.preventDefault()})
slider.addEventListener("touchend",function(event) {event.preventDefault()})
slider.addEventListener("touchcancel",function(event) {event.preventDefault()})
slider.addEventListener('pointerdown',e=>{
    window.addEventListener('pointermove',resize);
    window.addEventListener('pointerup', stopResize);
    function resize(e){
        canvasheight=Math.max(Math.min(window.innerHeight-e.clientY-10*window.devicePixelRatio,window.innerHeight-40),0);
        resizecanvas();
    }
    function stopResize() {
        window.removeEventListener('pointermove', resize);
        window.removeEventListener('pointerup', stopResize);
    }
});
const evCache = [];
let prevDiff = -1;
let prevx=undefined;
let prevy=undefined;
let lasttaptime=Date.now();
function gesturedown(ev) {
  evCache.push(ev);
}
function seeall(){
    let width=canvas.width;
    let height=canvas.height;
    let xmin=Number.POSITIVE_INFINITY;
    let xmax=Number.NEGATIVE_INFINITY;
    let ymin=Number.POSITIVE_INFINITY;
    let ymax=Number.NEGATIVE_INFINITY;
    for(let i=0;i<letters.length;i++){
        if(letters[i].xmin<xmin){
            xmin=letters[i].xmin;
        }
        if(letters[i].xmax>xmax){
            xmax=letters[i].xmax;
        }
        if(letters[i].ymin<ymin){
            ymin=letters[i].ymin;
        }
        if(letters[i].ymax>ymax){
            ymax=letters[i].ymax;
        }
    }
    if(Math.min(...points.x)<xmin){
        xmin=Math.min(...points.x);
    }
    if(Math.max(...points.x)>xmax){
        xmax=Math.max(...points.x);
    }
    if(Math.min(...points.y)<ymin){
        ymin=Math.min(...points.y);
    }
    if(Math.max(...points.y)>ymax){
        ymax=Math.max(...points.y);
    }
    //*.8+40 for so not on edge
    if(isFinite(xmin)&&isFinite(xmax)&&isFinite(ymin)&&isFinite(ymax)){
        translateletters(-xmin,-ymin);
        if((ymax-ymin)/height>(xmax-xmin)/width){
            scaleletters(.8*height/(ymax-ymin));
            translateletters(Math.max(0,width/4-height/(ymax-ymin)*(xmax-xmin)/2),40);
        }else{
            scaleletters(.8*width/(xmax-xmin));
            translateletters(0,40+height/2-width/(xmax-xmin)*(ymax-ymin)/2);
        }
    }
    draw();
}
function gesturemove(ev) {
    const index = evCache.findIndex((cachedEv) => cachedEv.pointerId === ev.pointerId);
    evCache[index] = ev;
    if(evCache.length===1){
        if(prevx!=undefined){
            let dx=evCache[0].clientX-prevx;
            let dy=evCache[0].clientY-prevy;
            translateletters(dx,dy);
            draw();
        }else if(Date.now()-lasttaptime<200){
            seeall();
        }
        prevx=evCache[0].clientX;
        prevy=evCache[0].clientY;
        lasttaptime=Date.now();
    }else if(evCache.length===2) {
        const curDiff = Math.hypot(evCache[0].clientX - evCache[1].clientX,evCache[0].clientY - evCache[1].clientY);
        if(prevDiff!==-1){
            let cx=(evCache[0].clientX+evCache[1].clientX)/2;
            let cy=(evCache[0].clientY+evCache[1].clientY)/2-(window.innerHeight-canvasheight-5*window.devicePixelRatio);
            translateletters(-cx,-cy);
            scaleletters(curDiff/prevDiff);
            translateletters(cx,cy);
            draw();
        }
        prevDiff = curDiff;
    }
}
function gestureup(ev) {
    const index = evCache.findIndex((cachedEv) => cachedEv.pointerId === ev.pointerId,);
    evCache.splice(index, 1);
    if (evCache.length < 2) {
        prevDiff = -1;
    }
    if(evCache.length!==1){
        prevx=undefined;
        prevy=undefined;
    }
}

resizecanvas();
window.addEventListener('resize', resizecanvas);
function resizecanvas(){
    resizelettercanvas();
    canvas.width=document.body.clientWidth;
    canvas.height=canvasheight;
    canvas.style.top=(window.innerHeight-canvasheight-5*window.devicePixelRatio)+"px";
    slider.width=document.body.clientWidth;
    slider.style.top=(window.innerHeight-canvasheight-slider.clientHeight-5*window.devicePixelRatio)+"px";
    buttoncontainer.style.top=(window.innerHeight-canvasheight-slider.clientHeight-5*window.devicePixelRatio)+"px";
    let lingrad=slider.getContext('2d').createLinearGradient(0,0,0,slider.height);
    lingrad.addColorStop(0,'grey');
    lingrad.addColorStop(.25,'lightgrey');
    lingrad.addColorStop(.5,'grey');
    lingrad.addColorStop(.75,'darkgrey');
    lingrad.addColorStop(1,'grey');
    slider.getContext('2d').fillStyle=lingrad;
    slider.getContext('2d').fillRect(0,0,slider.width,slider.height);
    if(document.getElementById("spaceforhandwriteinput")!==null){
        document.getElementById("spaceforhandwriteinput").height=canvasheight+slider.clientHeight;
        document.getElementById('container').scrollTo(document.getElementById('container').scrollLeft,document.getElementById('container').scrollHeight);
    }
    draw();
}
function currentpos(event){
    const boundbox=canvas.getBoundingClientRect();
    const x=event.clientX-boundbox.left;
    const y=(event.clientY-boundbox.top);
    return {x:x,y:y};
}
function pointerDown(event){
    isdrawing=true;
    const xy=currentpos(event);
    if(points.x.length>0){
        points.x.push(NaN);
        points.y.push(NaN);
    }
    points.x.push(xy.x);
    points.y.push(xy.y);
    ctx.beginPath();
    ctx.moveTo(xy.x,xy.y);
    if (event.pointerType === 'touch'){
        event.preventDefault();
    }
}
function pointerMove(event){
    if(!isdrawing)return;
    event.preventDefault();
    const xy=currentpos(event);
    points.x.push(xy.x);
    points.y.push(xy.y);
    ctx.lineTo(xy.x,xy.y);
    ctx.strokeStyle = '#000000'
    ctx.stroke();
}
async function pointerUp(event){
    isdrawing=false;
    event.preventDefault();
    let xmin=Math.min(...points.x.filter(v=>isFinite(v)));
    let xmax=Math.max(...points.x.filter(v=>isFinite(v)));
    let ymin=Math.min(...points.y.filter(v=>isFinite(v)));
    let ymax=Math.max(...points.y.filter(v=>isFinite(v)));
    if(Math.max(xmax-xmin,ymax-ymin)<Math.max(ctx.canvas.width,ctx.canvas.height)*.005){
        let xx=(xmax+xmin)/2;
        let yy=(ymax+ymin)/2;
        let oclsize=Number.POSITIVE_INFINITY;
        let ocli=-1;
        for(let i=0;i<letters.length;i++){
            if(letters[i].xmin<xx&&xx<letters[i].xmax&&letters[i].ymin<yy&&yy<letters[i].ymax){
                let ls=(letters[i].xmax-letters[i].xmin)*(letters[i].ymax-letters[i].ymin);
                if(ls<oclsize){
                    oclsize=ls;
                    ocli=i;
                }
            }
            if(ocli>-1){
                console.log("OPEN CHANGE LETTER");
                lettertomodifyindex=ocli;
                nninfomodify=getinputfornn(letters[ocli].points);
                drawnninfo();
                fixletteroverlay.style.visibility="Visible";
            }
        }
        points.x=[];
        points.y=[];
        draw();
        return
    }
    lines.push(structuredClone(points));
    points.x=[];
    points.y=[];
    await lines2letters([xmin,xmax,ymin,ymax]);
    draw();
    letters2eq();
}
function draw(){
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if(lines.length===0&&letters.length===0){
        const instructiontext="Handwrite Here. Scribble to Erase.";
        let fontsize=10;
        ctx.font=`${fontsize}px 'Segoe Print', cursive`;
        ctx.fillStyle='#8a8a8a';
        while(ctx.measureText(instructiontext).width<canvas.width&&fontsize<canvas.height/2){
            fontsize++;
            ctx.font=`${fontsize}px 'Segoe Print', cursive`;
        }
        fontsize--;
        ctx.font=`${fontsize}px 'Segoe Print', cursive`;
        ctx.fillText(instructiontext,0,(canvas.height+fontsize)/2);
    }
    ctx.strokeStyle="#00FF00";
    ctx.lineWidth=3;
    for(let i=0;i<lines.length;i++){
        ctx.beginPath();
        ctx.moveTo(lines[i].x[0],lines[i].y[0]);
        for(let ii=0;ii<lines[i].x.length;ii++){
            if(isNaN(lines[i].x[ii])){
                ctx.stroke();
                ctx.beginPath();
                ii++;
                ctx.moveTo(lines[i].x[ii],lines[i].y[ii]);
            }else{
                ctx.lineTo(lines[i].x[ii],lines[i].y[ii]);
            }            
        }
        ctx.stroke();
    }
    ctx.strokeStyle="#000000";
    ctx.lineWidth=1;
    ctx.beginPath();
    ctx.moveTo(points.x[0],points.y[0]);
    for(let ii=0;ii<points.x.length;ii++){
        if(isNaN(points.x[ii])){
            ctx.beginPath();
            ii++;
            ctx.moveTo(points.x[ii],points.y[ii]);
        }else{
            ctx.lineTo(points.x[ii],points.y[ii]);
            ctx.stroke();
        }
    }
    for(let i=0;i<letters.length;i++){
        if(letters[i].points.x.length===0){
            letters.splice(i,1);
            i--;
            console.log("NEED TO FIND REASON LETTER HAS NO POINTS");
            continue
        }
        ctx.strokeStyle = '#000000';
        ctx.beginPath();
        ctx.moveTo(letters[i].points.x[0],letters[i].points.y[0]);
        for(let ii=0;ii<letters[i].points.x.length;ii++){
            if(isNaN(letters[i].points.x[ii])){
                ctx.beginPath();
                ii++;
                ctx.moveTo(letters[i].points.x[ii],letters[i].points.y[ii]);
            }else{
                ctx.lineTo(letters[i].points.x[ii],letters[i].points.y[ii]);
                ctx.stroke();
            }
        }
    }
}
function scaleletters(s){
    for(let i=0;i<letters.length;i++){
        letters[i].xmin*=s;
        letters[i].xmax*=s;
        letters[i].ymin*=s;
        letters[i].ymax*=s;
        letters[i].baseline*=s;
        letters[i].midline*=s;
        for(let ii=0;ii<letters[i].points.x.length;ii++){
            letters[i].points.x[ii]*=s;
            letters[i].points.y[ii]*=s;
        }
    }
    for(i=0;i<points.x.length;i++){
        points.x[i]*=s;
        points.y[i]*=s;
    }
    for(i=0;i<lines.length;i++){
        for(let ii=0;ii<lines[i].x.length;ii++){
            lines[i].x[ii]*=s;
            lines[i].y[ii]*=s;
        }
    }
}
function translateletters(x,y){
    for(let i=0;i<letters.length;i++){
        letters[i].xmin+=x;
        letters[i].xmax+=x;
        letters[i].ymin+=y;
        letters[i].ymax+=y;
        letters[i].baseline+=y;
        letters[i].midline+=y;
        for(let ii=0;ii<letters[i].points.x.length;ii++){
            letters[i].points.x[ii]+=x;
            letters[i].points.y[ii]+=y;
        }
    }
    for(i=0;i<points.x.length;i++){
        points.x[i]+=x;
        points.y[i]+=y;
    }
    for(i=0;i<lines.length;i++){
        for(let ii=0;ii<lines[i].x.length;ii++){
            lines[i].x[ii]+=x;
            lines[i].y[ii]+=y;
        }
    }
}
screen.orientation.addEventListener("change", (event) => {
    if(screen.orientation.type.startsWith("portrait")){
        portraitheight=window.outerHeight;
        canvasheight=canvasheight/landscapeheight*portraitheight;
    }else{
        landscapeheight=window.outerHeight;
        canvasheight=canvasheight/portraitheight*landscapeheight;
    }
    resizecanvas();
});
canvas.addEventListener('pointerdown', pointerDown);
canvas.addEventListener('pointermove', pointerMove);
canvas.addEventListener('pointerup', pointerUp);
canvas.addEventListener('pointerleave',function(event){gestureup(event);isdrawing=false;event.preventDefault();})
canvas.addEventListener("touchstart",function(event) {event.preventDefault()})
canvas.addEventListener("touchmove",function(event) {event.preventDefault()})
canvas.addEventListener("touchend",function(event) {event.preventDefault()})
canvas.addEventListener("touchcancel",function(event) {gestureup(event);event.preventDefault()})
canvas.addEventListener('wheel',(event)=>{
    event.preventDefault();
    let x=event.offsetX;
    let y=event.offsetY;
    let zoomamount=event.deltaY<0?1.1:.9;
    translateletters(-x,-y);
    scaleletters(zoomamount);
    translateletters(x,y);
    draw()
},{passive:false});
hide();
function hide(){
    canvas.hidden=true;
    buttonwrite.hidden=true;
    slider.hidden=true;
    buttoncontainer.hidden=true;
}
function show(){
    canvas.hidden=false;
    buttonwrite.hidden=false;
    slider.hidden=false;
    buttoncontainer.hidden=false;
}
function clearletters(){
    lines.splice(0);
    letters.splice(0);
    points.x.splice(0);
    points.y.splice(0);
    draw();
}

async function lines2letters(newpointbounds){
    //get lines near bounds
    let linelengths=[];
    for(let i=0;i<lines.length;i++){
        let xmin=Math.min(...lines[i].x.filter(v=>Number.isFinite(v)));
        let xmax=Math.max(...lines[i].x.filter(v=>Number.isFinite(v)));
        let ymin=Math.min(...lines[i].y.filter(v=>Number.isFinite(v)));
        let ymax=Math.max(...lines[i].y.filter(v=>Number.isFinite(v)));
        linelengths.push(Math.max(xmax-xmin,ymax-ymin));
    }
    linelengths.sort((a,b)=>a-b);
    let Q1=linelengths[Math.floor(linelengths.length*.25)];
    let medianll=linelengths[Math.floor(linelengths.length*.5)];
    let Q3=linelengths[Math.floor(linelengths.length*.75)];
    let IQR=Q3-Q1;
    let maxnotoutlier=medianll+IQR/2;
    let lettersize=linelengths.reduce((max,current)=>current<maxnotoutlier&&current>max?current:max,0);
    let dotsize=lettersize/4;
    let wlines=[];
    let wlinesi=[];
    for(let i=0;i<lines.length;i++){
        let xmin=Math.min(...lines[i].x.filter(v=>Number.isFinite(v)));
        let xmax=Math.max(...lines[i].x.filter(v=>Number.isFinite(v)));
        let ymin=Math.min(...lines[i].y.filter(v=>Number.isFinite(v)));
        let ymax=Math.max(...lines[i].y.filter(v=>Number.isFinite(v)));
        if(lines.length<20||xmin>newpointbounds[0]-5*lettersize&&xmax<newpointbounds[1]+5*lettersize&&ymin>newpointbounds[2]-5*lettersize&&ymax<newpointbounds[3]+5*lettersize){
            wlines.push(structuredClone(lines[i]));
            wlinesi.push(i);
        }
    }
    for(let i=0;i<wlinesi.length;i++){
        let xmin=Math.min(...lines[wlinesi[i]].x.filter(v=>Number.isFinite(v)));
        let xmax=Math.max(...lines[wlinesi[i]].x.filter(v=>Number.isFinite(v)));
        let ymin=Math.min(...lines[wlinesi[i]].y.filter(v=>Number.isFinite(v)));
        let ymax=Math.max(...lines[wlinesi[i]].y.filter(v=>Number.isFinite(v)));
        for(let ii=0;ii<lines.length;ii++){
            if(wlinesi.includes(ii)){
                continue
            }
            let xminii=Math.min(...lines[ii].x.filter(v=>Number.isFinite(v)));
            let xmaxii=Math.max(...lines[ii].x.filter(v=>Number.isFinite(v)));
            let yminii=Math.min(...lines[ii].y.filter(v=>Number.isFinite(v)));
            let ymaxii=Math.max(...lines[ii].y.filter(v=>Number.isFinite(v)));
            if(!(xmax<xminii||xmin>xmaxii||ymax<yminii||ymin>ymaxii)){
                wlines.push(structuredClone(lines[ii]));
                wlinesi.push(ii);
            }
        }
    }
    //join touching or very close lines
    for(let i=0;i<wlines.length;i++){
        let xmin=Math.min(...wlines[i].x.filter(v=>Number.isFinite(v)));
        let xmax=Math.max(...wlines[i].x.filter(v=>Number.isFinite(v)));
        let ymin=Math.min(...wlines[i].y.filter(v=>Number.isFinite(v)));
        let ymax=Math.max(...wlines[i].y.filter(v=>Number.isFinite(v)));
        for(let ii=i+1;ii<wlines.length;ii++){
            let xminii=Math.min(...wlines[ii].x.filter(v=>Number.isFinite(v)));
            let xmaxii=Math.max(...wlines[ii].x.filter(v=>Number.isFinite(v)));
            let yminii=Math.min(...wlines[ii].y.filter(v=>Number.isFinite(v)));
            let ymaxii=Math.max(...wlines[ii].y.filter(v=>Number.isFinite(v)));
            if(!(xmax<xminii||xmaxii<xmin||ymax<yminii||ymaxii<ymin)){
                let mindist=mindistbetween(wlines[i],wlines[ii]);
                if(mindist<lettersize/20){
                    wlines[i].x=[...wlines[i].x,NaN,...wlines[ii].x];
                    wlines[i].y=[...wlines[i].y,NaN,...wlines[ii].y];
                    wlines.splice(ii,1);
                    i--;
                    break
                }
            }
        }
    }
    //join dots to i, j
    let ijlines=[];
    let ijrem=[];
    let ijdist=[];
    for(let i=0;i<wlines.length;i++){
        let xmin=Math.min(...wlines[i].x.filter(v=>Number.isFinite(v)));
        let xmax=Math.max(...wlines[i].x.filter(v=>Number.isFinite(v)));
        let ymin=Math.min(...wlines[i].y.filter(v=>Number.isFinite(v)));
        let ymax=Math.max(...wlines[i].y.filter(v=>Number.isFinite(v)));
        let midi=(xmax+xmin)/2;
        let posdot=[];
        for(let ii=i+1;ii<wlines.length;ii++){
            let xminii=Math.min(...wlines[ii].x.filter(v=>Number.isFinite(v)));
            let xmaxii=Math.max(...wlines[ii].x.filter(v=>Number.isFinite(v)));
            let midii=(xmaxii+xminii)/2;
            if(Math.abs(midi-midii)<lettersize){
                posdot.push(ii);
            }
        }
        if(posdot.length>0){
            let doti=-1;
            for(let ii=0;ii<posdot.length;ii++){
                let xminii=Math.min(...wlines[posdot[ii]].x.filter(v=>Number.isFinite(v)));
                let xmaxii=Math.max(...wlines[posdot[ii]].x.filter(v=>Number.isFinite(v)));
                let yminii=Math.min(...wlines[posdot[ii]].y.filter(v=>Number.isFinite(v)));
                let ymaxii=Math.max(...wlines[posdot[ii]].y.filter(v=>Number.isFinite(v)));
                if(ymaxii-yminii>ymax-ymin){
                    //ii stick
                    if(ymaxii-yminii>.5*(xmaxii-xminii)&&ymax<yminii&&ymin>yminii-2*(ymaxii-yminii)&&Math.max(xmax-xmin,ymax-ymin)<Math.max(xmaxii-xminii,ymaxii-yminii)/3){
                        if(doti===-1||(Math.abs((xminii+xmaxii)/2-midi)<Math.abs((Math.min(...wlines[doti].x.filter(v=>Number.isFinite(v)))+Math.max(...wlines[doti].x.filter(v=>Number.isFinite(v))))/2-midi))){
                            doti=posdot[ii];
                        }
                    }
                }else{
                    //i stick
                    if(ymax-ymin>.5*(xmax-xmin)&&ymaxii<ymin&&yminii>ymin-2*(ymax-ymin)&&Math.max(xmaxii-xminii,ymaxii-yminii)<Math.max(xmax-xmin,ymax-ymin)/3){
                        if(doti===-1||(Math.abs((xminii+xmaxii)/2-midi)<Math.abs((Math.min(...wlines[doti].x.filter(v=>Number.isFinite(v)))+Math.max(...wlines[doti].x.filter(v=>Number.isFinite(v))))/2-midi))){
                            doti=posdot[ii];
                        }
                    }
                }
            }
            if(doti!==-1){
                let dotxmin=Math.min(...wlines[doti].x.filter(v=>Number.isFinite(v)));
                let dotxmax=Math.max(...wlines[doti].x.filter(v=>Number.isFinite(v)));
                let dotymin=Math.min(...wlines[doti].y.filter(v=>Number.isFinite(v)));
                let dotymax=Math.max(...wlines[doti].y.filter(v=>Number.isFinite(v)));
                let canbeij=dotxmax-dotxmin<dotsize&&dotymax-dotymin<dotsize;
                let ijxmin=Math.min(xmin,dotxmin);
                let ijxmax=Math.max(xmax,dotxmax);
                let ijymin=Math.min(ymin,dotymin);
                let ijymax=Math.max(ymax,dotymax);
                for(let ii=0;ii<wlines.length;ii++){
                    if(i===ii||i===doti){
                        continue
                    }
                    let xminii=Math.min(...wlines[ii].x.filter(v=>Number.isFinite(v)));
                    let xmaxii=Math.max(...wlines[ii].x.filter(v=>Number.isFinite(v)));
                    let yminii=Math.min(...wlines[ii].y.filter(v=>Number.isFinite(v)));
                    let ymaxii=Math.max(...wlines[ii].y.filter(v=>Number.isFinite(v)));
                    if(xminii<ijxmin&&xmaxii>ijxmax&&yminii>ijymin&&ymaxii<ijymax){
                        canbeij=false;
                        break
                    }
                }
                if(canbeij){
                    if(ijrem.includes(i)||ijrem.includes(doti)){
                        let xc=[...wlines[i].x,NaN,...wlines[doti].x];
                        let xo;
                        let xoi;
                        if(ijrem.includes(i)){
                            xoi=Math.floor(ijrem.indexOf(i)/2);
                            xo=ijlines[xoi].x;
                        }else{
                            xoi=Math.floor(ijrem.indexOf(doti)/2);
                            xo=ijlines[xoi].x;
                        }
                        if(Math.max(...xc.filter(v=>isFinite(v)))-Math.min(...xc.filter(v=>isFinite(v)))<Math.max(...xo.filter(v=>isFinite(v)))-Math.min(...xo.filter(v=>isFinite(v)))){
                            ijrem=ijrem.filter((_,v)=>!(v===2*xoi||v===2*xoi+1));
                            ijlines=ijlines.filter((_,v)=>v!==xoi);
                            ijrem.push(i,doti);
                            ijlines.push({"x":[...wlines[i].x,NaN,...wlines[doti].x],"y":[...wlines[i].y,NaN,...wlines[doti].y]});
                        }
                    }else{
                        ijrem.push(i,doti);
                        ijlines.push({"x":[...wlines[i].x,NaN,...wlines[doti].x],"y":[...wlines[i].y,NaN,...wlines[doti].y]});
                    }
                }
            }
        }
    }
    if(ijrem.length>0){
        wlines=wlines.filter((_,i)=>!ijrem.includes(i));
        wlines.push(...ijlines);
    }
    //join =
    let negis=[];
    for(let i=0;i<wlines.length;i++){
        let [ratioaway,ang,xstart,ystart,linelength]=lineminperpendiculardist(wlines[i].x,wlines[i].y);
        if(ratioaway<.1){
            if(ang<=Math.PI/8||ang>=7*Math.PI/8){
                negis.push(i);
            }
        }
    }
    if(negis.length>1){
        let remnegisi=[];
        let eqlines=[];
        for(let i=0;i<negis.length;i++){
            let xmini=Math.min(...wlines[negis[i]].x.filter(v=>Number.isFinite(v)));
            let xmaxi=Math.max(...wlines[negis[i]].x.filter(v=>Number.isFinite(v)));
            let ymini=Math.min(...wlines[negis[i]].y.filter(v=>Number.isFinite(v)));
            let ymaxi=Math.max(...wlines[negis[i]].y.filter(v=>Number.isFinite(v)));
            let midyi=(ymini+ymaxi)/2;
            for(let ii=i+1;ii<negis.length;ii++){
                let xminii=Math.min(...wlines[negis[ii]].x.filter(v=>Number.isFinite(v)));
                let xmaxii=Math.max(...wlines[negis[ii]].x.filter(v=>Number.isFinite(v)));
                let yminii=Math.min(...wlines[negis[ii]].y.filter(v=>Number.isFinite(v)));
                let ymaxii=Math.max(...wlines[negis[ii]].y.filter(v=>Number.isFinite(v)));
                let midyii=(yminii+ymaxii)/2;
                if(Math.abs((xmaxi+xmini)/2-(xmaxii+xminii)/2)<Math.min(xmaxi-xmini,xmaxii-xminii)/4&&Math.min(xmaxi-xmini,xmaxii-xminii)/Math.max(xmaxi-xmini,xmaxii-xminii)>.5&&Math.abs(midyi-midyii)<Math.max(xmaxi-xmini,xmaxii-xminii)){
                    let isequals=true;
                    for(let iii=0;iii<wlines.length;iii++){
                        if(iii===negis[i]||iii===negis[ii]){
                            continue
                        }
                        let xmin=Math.min(...wlines[iii].x.filter(v=>Number.isFinite(v)));
                        let xmax=Math.max(...wlines[iii].x.filter(v=>Number.isFinite(v)));
                        let ymin=Math.min(...wlines[iii].y.filter(v=>Number.isFinite(v)));
                        let ymax=Math.max(...wlines[iii].y.filter(v=>Number.isFinite(v)));
                        let cx=(xmax+xmin)/2;
                        let cy=(ymax+ymin)/2;
                        if(Math.min(xmini,xminii)<cx&&cx<Math.max(xmaxi,xmaxii)&&Math.min(ymini,yminii)<cy&&cy<Math.max(ymaxi,ymaxii)){
                            isequals=false;
                            break
                        }
                    }
                    if(isequals){
                        remnegisi.push(i,ii);
                        eqlines.push({"x":[...wlines[negis[i]].x,NaN,...wlines[negis[ii]].x],"y":[...wlines[negis[i]].y,NaN,...wlines[negis[ii]].y]});
                    }
                }
            }
        }
        let remeqlines=negis.filter((_,i)=>remnegisi.includes(i));
        wlines=wlines.filter((_,i)=>!remeqlines.includes(i));
        wlines.push(...eqlines);
        negis=negis.filter((_,i)=>!remnegisi.includes(i));
    }
    //join ÷
    if(negis.length>0){
        negis=[];
        for(let i=0;i<wlines.length;i++){
            let [ratioaway,ang,xstart,ystart,linelength]=lineminperpendiculardist(wlines[i].x,wlines[i].y);
            if(ratioaway<.08){
                if(ang<=Math.PI/8||ang>=7*Math.PI/8){
                    negis.push(i);
                }
            }
        }
        let makedivi=[];
        let divs=[];
        for(let i=0;i<negis.length;i++){
            let abi=[];
            let xmini=Math.min(...wlines[negis[i]].x.filter(v=>Number.isFinite(v)));
            let xmaxi=Math.max(...wlines[negis[i]].x.filter(v=>Number.isFinite(v)));
            let ymini=Math.min(...wlines[negis[i]].y.filter(v=>Number.isFinite(v)));
            let ymaxi=Math.max(...wlines[negis[i]].y.filter(v=>Number.isFinite(v)));
            let midyi=(ymini+ymaxi)/2;
            for(let ii=0;ii<wlines.length;ii++){
                if(negis[i]===ii){
                    continue
                }
                let xminii=Math.min(...wlines[ii].x.filter(v=>Number.isFinite(v)));
                let xmaxii=Math.max(...wlines[ii].x.filter(v=>Number.isFinite(v)));
                let yminii=Math.min(...wlines[ii].y.filter(v=>Number.isFinite(v)));
                let ymaxii=Math.max(...wlines[ii].y.filter(v=>Number.isFinite(v)));
                if(xminii>xmini+(xmaxi-xmini)/4&&xmaxii<xmaxi-(xmaxi-xmini)/4&&Math.max(xmaxii-xminii,ymaxii-yminii)<(xmaxi-xmini)/5&&Math.max(Math.abs(ymaxii-midyi),Math.abs(yminii-midyi))<(xmaxi-xmini)){
                    abi.push(ii);
                }
            }
            if(abi.length===2){
                let ymin0=Math.min(...wlines[abi[0]].y.filter(v=>Number.isFinite(v)));
                let ymax0=Math.max(...wlines[abi[0]].y.filter(v=>Number.isFinite(v)));
                let ymin1=Math.min(...wlines[abi[1]].y.filter(v=>Number.isFinite(v)));
                let ymax1=Math.max(...wlines[abi[1]].y.filter(v=>Number.isFinite(v)));
                let nothingelse=true;
                for(let ii=0;ii<wlines.length;ii++){
                    if(ii===abi[0]||ii===abi[1]||ii===negis[i]){
                        continue
                    }
                    if(Math.max(...wlines[ii].x.filter(v=>Number.isFinite(v)))>xmini&&
                       Math.min(...wlines[ii].x.filter(v=>Number.isFinite(v)))<xmaxi&&
                       Math.max(...wlines[ii].y.filter(v=>Number.isFinite(v)))>Math.min(ymin0,ymin1)&&
                       Math.min(...wlines[ii].y.filter(v=>Number.isFinite(v)))<Math.min(ymax0,ymax1)){
                        nothingelse=false;
                        break
                       }
                }
                if(nothingelse&&(ymax0<midyi&&ymin1>midyi||ymax1<midyi&&ymin0>midyi)){
                    makedivi.push([negis[i],...abi]);
                    divs.push({"x":[...wlines[makedivi.at(-1)[0]].x,NaN,...wlines[makedivi.at(-1)[1]].x,NaN,...wlines[makedivi.at(-1)[2]].x],"y":[...wlines[makedivi.at(-1)[0]].y,NaN,...wlines[makedivi.at(-1)[1]].y,NaN,...wlines[makedivi.at(-1)[2]].y]});
                }
            }
        }
        makedivi=makedivi.flat();
        wlines=wlines.filter((_,i)=>!makedivi.includes(i));
        wlines.push(...divs);
    }
    //convert lines to letters
    for(let i=0;i<wlines.length;i++){
        let check=false;
        for(let ii=0;ii<wlines[i].x.length;ii++){
            if(wlines[i].x[ii]>=newpointbounds[0]&&wlines[i].x[ii]<=newpointbounds[1]&&wlines[i].y[ii]>=newpointbounds[2]&&wlines[i].y[ii]<=newpointbounds[3]){
                check=true;
                break
            }
        }
        if(check){
            let xmin=Math.min(...wlines[i].x.filter(v=>Number.isFinite(v)));
            let xmax=Math.max(...wlines[i].x.filter(v=>Number.isFinite(v)));
            let ymin=Math.min(...wlines[i].y.filter(v=>Number.isFinite(v)));
            let ymax=Math.max(...wlines[i].y.filter(v=>Number.isFinite(v)));
            let letter=await workoutchar(wlines[i]);
            if(letter==='delete'||letter===undefined){
                for(let ii=letters.length-1;ii>=0;ii--){
                    if(!(letters[ii].xmax<xmin||xmax<letters[ii].xmin||letters[ii].ymax<ymin||ymax<letters[ii].ymin)){
                        let bothhavepoint=false;
                        for(let iii=0;iii<wlines[i].x.length;iii++){
                            for(let iv=0;iv<letters[ii].points.x.length;iv++){
                                let dist=((wlines[i].x[iii]-letters[ii].points.x[iv])**2+(wlines[i].y[iii]-letters[ii].points.y[iv])**2)**.5;
                                if(Number.isFinite(dist)&&dist<lettersize/20){
                                    bothhavepoint=true;
                                    break
                                }
                            }
                        }
                        if(bothhavepoint){
                            letters.splice(ii,1);
                        }
                    }
                }
                for(let ii=lines.length-1;ii>=0;ii--){
                    let xminii=Math.min(...lines[ii].x.filter(v=>Number.isFinite(v)));
                    let xmaxii=Math.max(...lines[ii].x.filter(v=>Number.isFinite(v)));
                    let yminii=Math.min(...lines[ii].y.filter(v=>Number.isFinite(v)));
                    let ymaxii=Math.max(...lines[ii].y.filter(v=>Number.isFinite(v)));
                    if(!(xmax<xminii||xmaxii<xmin||ymax<yminii||ymaxii<ymin)){
                        let bothhavepoint=false;
                        for(let iii=0;iii<wlines[i].x.length;iii++){
                            for(let iv=0;iv<lines[ii].x.length;iv++){
                                let dist=((wlines[i].x[iii]-lines[ii].x[iv])**2+(wlines[i].y[iii]-lines[ii].y[iv])**2)**.5;
                                if(Number.isFinite(dist)&&dist<lettersize/20){
                                    bothhavepoint=true;
                                    break
                                }
                            }
                            if(bothhavepoint){
                                break
                            }
                        }
                        if(bothhavepoint){
                            lines.splice(ii,1);
                        }
                    }
                }
            }else{
                for(let ii=letters.length-1;ii>=0;ii--){
                    let xminii=letters[ii].xmin;
                    let xmaxii=letters[ii].xmax;
                    let yminii=letters[ii].ymin;
                    let ymaxii=letters[ii].ymax;
                    if(!(xmax<xminii||xmaxii<xmin||ymax<yminii||ymaxii<ymin)){
                        let bothhavepoint=false;
                        for(let iii=0;iii<wlines[i].x.length;iii++){
                            for(let iv=0;iv<letters[ii].points.x.length;iv++){
                                let dist=((wlines[i].x[iii]-letters[ii].points.x[iv])**2+(wlines[i].y[iii]-letters[ii].points.y[iv])**2)**.5;
                                if(Number.isFinite(dist)&&dist<lettersize/20){
                                    bothhavepoint=true;
                                    break
                                }
                            }
                            if(bothhavepoint){
                                break
                            }
                        }
                        if(bothhavepoint){
                            letters.splice(ii,1);
                        }
                    }
                }
                if(Math.max(xmax-xmin,ymax-ymin)<dotsize){
                    if(letter==='/'||letter==='1'||letter==='r'){
                        letter=',';
                    }else{
                        letter='.';
                    }
                }
                let prop={
                    letter:letter,
                    xmin:xmin,
                    xmax:xmax,
                    ymin:ymin,
                    ymax:ymax,
                    baseline:letter==='g'||letter==='p'||letter==='q'||letter==='j'||letter==='y'?(ymax+ymin)/2:ymax,
                    midline:/^[0-9]$/i.test(letter)||/^[A-Z]$/.test(letter)||letter==='i'||letter==='b'||letter==='d'||letter==='f'||letter==='h'||letter==='k'||letter==='l'||letter==='t'||letter==='÷'||letter==='√'||letter==='*'||letter==='+'||letter==='('||letter===')'||letter==='='||letter==='-'||letter==='∞'||letter==='/'||letter==='\\'?(ymax+ymin)/2:ymin,
                    points:{x:[...wlines[i].x],y:[...wlines[i].y]}
                };
                letters.push(prop);
            }
        }
    }
}
function letters2eq(){
    let lettersizes=letters.filter(v=>v.letter!=='-').map(v=>v.letter==="√"?(v.ymax-v.ymin)*.8:Math.max(v.xmax-v.xmin,v.ymax-v.ymin)).sort((a,b)=>a-b);
    let medianls=lettersizes[Math.floor(lettersizes.length/2)];
    letters.sort((a,b)=>a.xmax-b.xmax);
    let eq=letters.map(v=>v);
    for(let i=eq.length-2;i>=0;i--){
        if(/^[a-z]$/i.test(eq[i].letter)){
            for(let ii=i+1;ii<eq.length;ii++){
                if(/^[a-z]$/i.test(eq[ii].letter)&&2*(eq[ii].baseline-eq[i].baseline)+.5*(eq[ii].ymin-eq[i].ymin)>(eq[i].ymax-eq[i].ymin)*.5&&eq[ii].ymin<=eq[i].ymax+medianls/5&&eq[ii].xmin>=(eq[i].xmin+eq[i].xmax)/2&&eq[ii].xmin<=eq[i].xmax+medianls/2&&(eq[ii].ymax-eq[ii].ymin)<(eq[i].ymax-eq[i].ymin)){
                    let prop={letter:eq[i].letter+'_'+eq[ii].letter,
                    xmax:Math.max(eq[i].xmax,eq[ii].xmax),
                    ymax:Math.max(eq[i].ymax,eq[ii].ymax),
                    xmin:Math.max(eq[i].xmin,eq[ii].xmin),
                    ymin:Math.max(eq[i].ymin,eq[ii].ymin),
                    midline:eq[i].midline,
                    baseline:eq[i].baseline,
                    }
                    eq[i]=prop;
                    eq.splice(ii,1);
                    break
                }else if(/^\d+$/i.test(eq[ii].letter)&&2*(eq[ii].baseline-eq[i].baseline)+.5*(eq[ii].ymin-eq[i].ymin)>(eq[i].ymax-eq[i].ymin)*.5&&eq[ii].ymin<=eq[i].ymax+medianls/5&&eq[ii].xmin>=(eq[i].xmin+eq[i].xmax)/2&&eq[ii].xmin<=eq[i].xmax+medianls/2&&(eq[ii].ymax-eq[ii].ymin)<(eq[i].ymax-eq[i].ymin)){
                    let subi=[ii];
                    let prop={letter:eq[i].letter+'_'+eq[ii].letter,
                    xmax:Math.max(eq[i].xmax,eq[ii].xmax),
                    ymax:Math.max(eq[i].ymax,eq[ii].ymax),
                    xmin:Math.min(eq[i].xmin,eq[ii].xmin),
                    ymin:Math.min(eq[i].ymin,eq[ii].ymin),
                    midline:eq[i].midline,
                    baseline:eq[i].baseline,
                    }
                    for(let iii=ii+1;iii<eq.length;iii++){
                        if(/^\d+$/i.test(eq[iii].letter)&&eq[i].baseline-(eq[i].baseline-eq[i].midline)/4<eq[iii].midline&&eq[iii].ymin<=eq[i].ymax+medianls/5&&eq[iii].xmin>=eq[subi[subi.length-1]].xmax-medianls/5&&eq[iii].xmin<=eq[subi[subi.length-1]].xmax+medianls/2){
                            prop.letter+=eq[iii].letter
                            prop.xmax=Math.max(prop.xmax,eq[iii].xmax),
                            prop.ymax=Math.max(prop.ymax,eq[iii].ymax),
                            prop.xmin=Math.min(prop.xmin,eq[iii].xmin),
                            prop.ymin=Math.min(prop.ymin,eq[iii].ymin),
                            subi.push(iii);
                        }
                    }
                    eq[i]=prop;
                    for(let iii=subi.length-1;iii>=0;iii--){
                        eq.splice(subi[iii],1);
                    }
                    break
                }
            }
        }else if(/^(\d*\.\d*|\d+)$/i.test(eq[i].letter)){
            for(let ii=i+1;ii<eq.length;ii++){
                if(!/^(\d*\.\d*|\d+)$/i.test(eq[ii].letter)&&!(eq[i].ymin>eq[ii].baseline||eq[i].ymax<eq[ii].ymin)){
                    break
                }else if(/^(\d*\.\d*|\d+)$/i.test(eq[ii].letter)&&Math.abs(eq[i].baseline-eq[ii].baseline)<medianls/3&&Math.abs(eq[ii].xmin-eq[i].xmax)<medianls/3){
                    let prop={letter:eq[i].letter+eq[ii].letter,
                    xmax:Math.max(eq[i].xmax,eq[ii].xmax),
                    ymax:Math.max(eq[i].ymax,eq[ii].ymax),
                    xmin:Math.min(eq[i].xmin,eq[ii].xmin),
                    ymin:Math.min(eq[i].ymin,eq[ii].ymin),
                    midline:eq[i].midline,
                    baseline:eq[i].baseline,
                    }
                    eq[i]=prop;
                    eq.splice(ii,1);
                    break
                }
            }
        }
    }
    //find brackets
    let xleft=Number.POSITIVE_INFINITY;
    let xright=Number.NEGATIVE_INFINITY;
    let ytop=Number.POSITIVE_INFINITY;
    let ybottom=Number.NEGATIVE_INFINITY;
    for(let i=0;i<eq.length;i++){
        if(xleft>eq[i].xmin){
            xleft=eq[i].xmin;
        }
        if(xright<eq[i].xmax){
            xright=eq[i].xmax;
        }
        if(ytop>eq[i].ymin){
            ytop=eq[i].ymin;
        }
        if(ybottom<eq[i].ymax){
            ybottom=eq[i].ymax;
        }
    }
    let bracketbox=[{type:'all',
        xl:xleft,
        xr:xright,
        yb:ybottom,
        yt:ytop,
        }];
    //equals
    //bracket
    //div
    // let prop={type:'=,(),√,/t,/b,/,^t,^b,^',xl:0,xr:0,yb:0,yt:0,area:0};
    let equalspos=[];
    for(let i=0;i<eq.length;i++){
        if(eq[i].letter==='='){
            equalspos.push([eq[i].xmin,eq[i].xmax]);
        }
    }
    equalspos.sort((a,b)=>a[0]-b[0]);
    for(let i=0;i<equalspos.length;i++){
        bracketbox.push({type:'=',
        xl:i===0?xleft:equalspos[i-1][1],
        xr:equalspos[i][0],
        yb:ybottom,
        yt:ytop,
        });
        if(equalspos.length-1==i){
            bracketbox.push({type:'=',
            xl:equalspos[i][1],
            xr:xright,
            yb:ybottom,
            yt:ytop,
            });
        }
    }
    let openbrac=[];
    let closebrac=[];
    for(let i=0;i<eq.length;i++){
        if(eq[i].letter==='('){
            openbrac.push([eq[i].xmin,eq[i].ymin,eq[i].ymax]);
        }else if(eq[i].letter===')'){
            closebrac.push([eq[i].xmax,eq[i].ymin,eq[i].ymax]);
        }
    }
    openbrac.sort((a,b)=>a[0]-b[0]);
    closebrac.sort((a,b)=>a[0]-b[0]);
    for(let i=openbrac.length-1;i>=0;i--){
        for(let ii=0;ii<closebrac.length;ii++){
            let bractol=Math.min(openbrac[i][2]-openbrac[i][1],closebrac[ii][2]-closebrac[ii][1])/3;
            if(closebrac[ii][0]>openbrac[i][0]&&Math.abs(openbrac[i][1]-closebrac[ii][1])<bractol&&Math.abs(openbrac[i][2]-closebrac[ii][2])<bractol){
                bracketbox.push({type:'()',
                xl:openbrac[i][0],
                xr:closebrac[ii][0],
                yb:Math.max(openbrac[i][2],closebrac[ii][2]),
                yt:Math.min(openbrac[i][1],closebrac[ii][1]),
                });
                openbrac.splice(i,1);
                closebrac.splice(ii,1);
                break
            }
        }
    }
    for(let i=0;i<openbrac.length;i++){
        bracketbox.push({type:'(',
        xl:openbrac[i][0],
        xr:xright,
        yb:openbrac[i][2],
        yt:openbrac[i][1],
        });
        for(let ii=0;ii<bracketbox.length;ii++){
            if(bracketbox[ii].type==='='&&bracketbox[ii].xl<=openbrac[i][0]&&bracketbox[ii].xr>openbrac[i][0]){
                bracketbox[bracketbox.length-1].xr=bracketbox[ii].xr;
                break
            }
        }
    }
    for(let i=0;i<closebrac.length;i++){
        bracketbox.push({type:')',
        xl:xleft,
        xr:closebrac[i][0],
        yb:closebrac[i][2],
        yt:closebrac[i][1],
        });
        for(let ii=0;ii<bracketbox.length;ii++){
            if(bracketbox[ii].type==='='&&bracketbox[ii].xl<closebrac[i][0]&&bracketbox[ii].xr>=closebrac[i][0]){
                bracketbox[bracketbox.length-1].xl=bracketbox[ii].xl;
                break
            }
        }
    }
    let minuspos=[];
    let intpos=[];
    for(let i=0;i<eq.length;i++){
        if(eq[i].letter==='√'){
            bracketbox.push({type:'√',
            xl:eq[i].xmin,
            xr:eq[i].xmax,
            yb:eq[i].ymax,
            yt:eq[i].ymin,
            });
        }else if(eq[i].letter==='-'){
            minuspos.push([eq[i].xmin,
            eq[i].xmax,
            (eq[i].ymax+eq[i].ymin)/2]);
        }else if(eq[i].letter==='∫'){
            intpos.push([eq[i].ymin,eq[i].ymax,eq[i].xmin]);
        }
    }
    //div brac
    for(let i=minuspos.length-1;i>=0;i--){
        let mindistabove=Number.POSITIVE_INFINITY;
        let mindistbelow=Number.POSITIVE_INFINITY;
        let letterabove='-';
        let letterbelow='-';
        for(let ii=0;ii<eq.length;ii++){
            if((eq[ii].xmin+eq[ii].xmax)/2>=minuspos[i][0]&&(eq[ii].xmin+eq[ii].xmax)/2<=minuspos[i][1]){
                let dabove=minuspos[i][2]-eq[ii].ymax;
                if(dabove>0&&dabove<mindistabove){
                    mindistabove=dabove;
                    letterabove=eq[ii].letter;
                }
                let dbelow=eq[ii].ymin-minuspos[i][2];
                if(dbelow>0&&dbelow<mindistbelow){
                    mindistbelow=dbelow;
                    letterbelow=eq[ii].letter;
                }
            }
        }
        if(isFinite(mindistabove)&&isFinite(mindistbelow)&&letterabove!=='-'&&letterbelow!=='-'||minuspos[i][1]-minuspos[i][0]>2*medianls){
            bracketbox.push({type:'/t',
            xl:minuspos[i][0],
            xr:minuspos[i][1],
            yb:minuspos[i][2],
            yt:ytop,
            });
            bracketbox.push({type:'/b',
            xl:minuspos[i][0],
            xr:minuspos[i][1],
            yb:ybottom,
            yt:minuspos[i][2],
            });
            bracketbox.push({type:'/',
            xl:minuspos[i][0],
            xr:minuspos[i][1],
            yb:ybottom,
            yt:ytop,
            });
        }else{
            minuspos.splice(i,1);
        }
    }
    minuspos.sort((a,b)=>a[2]-b[2]);
    for(let i=0;i<minuspos.length;i++){
        for(let ii=i+1;ii<minuspos.length;ii++){
            let isoverlaping=false;
            if(minuspos[i][1]<minuspos[ii][1]){
                if(minuspos[i][1]>=minuspos[ii][0]){
                    isoverlaping=true;
                }
            }else{
                if(minuspos[ii][1]>=minuspos[i][0]){
                    isoverlaping=true;
                }
            }
            if(isoverlaping){
                let ilongerii=minuspos[i][1]-minuspos[i][0]>minuspos[ii][1]-minuspos[ii][0]
                for(let iii=0;iii<bracketbox.length;iii++){
                    if(!ilongerii&&bracketbox[iii].xl===minuspos[i][0]&&bracketbox[iii].xr===minuspos[i][1]){
                        bracketbox[iii].yb=Math.min(minuspos[ii][2],bracketbox[iii].yb);
                    }else if(ilongerii&&bracketbox[iii].xl===minuspos[ii][0]&&bracketbox[iii].xr===minuspos[ii][1]){
                        bracketbox[iii].yt=Math.max(minuspos[i][2],bracketbox[iii].yt)
                    }
                }
            }
        }
    }
    //intbrac
    for(let i=0;i<intpos.length;i++){
        let insideint=0;
        for(let ii=0;ii<eq.length;ii++){
            let cy=(eq[ii].ymax+eq[ii].ymin)/2;
            if(eq[ii].letter==='∫'&&intpos[i][0]<cy&&cy<intpos[i][1]&&intpos[i][2]<eq[ii].xmin){
                insideint+=1;
            }
            if(eq[ii].letter==='d'){
                if(intpos[i][0]<cy&&cy<intpos[i][1]&&intpos[i][2]<eq[ii].xmin){
                    for(let iii=0;iii<eq.length;iii++){
                        let cy=(eq[iii].ymax+eq[iii].ymin)/2;
                        if(intpos[i][0]<cy&&cy<intpos[i][1]&&eq[ii].xmax<(eq[iii].xmin+eq[iii].xmax)/2&&/[a-zA-Z]/.test(eq[iii].letter)){
                            if(insideint>0){
                                insideint--;
                                break
                            }else{
                                intpos[i].push(eq[iii].xmax);
                                intpos[i].push(eq[iii]);
                                intpos[i].push(eq[ii]);
                                bracketbox.push({type:'∫'+i,
                                xl:intpos[i][2],
                                xr:intpos[i][3],
                                yb:intpos[i][1],
                                yt:intpos[i][0],
                                });
                                let mininsideint=intpos[i][3];
                                for(let iv=0;iv<eq.length;iv++){
                                    let cy=(eq[iv].ymax+eq[iv].ymin)/2;
                                    if(eq[iv].letter==='∫'&&intpos[i][2]<eq[iv].xmin&&eq[iv].xmax<intpos[i][3]&&intpos[i][0]<cy&&cy<intpos[i][1]&&eq[iv].xmin<mininsideint){
                                        mininsideint=eq[iv].xmin;
                                    }
                                }
                                let maxleftint=Math.max(xleft,...bracketbox.filter(v=>v.type!=='∫'&&v.xl<intpos[i][2]).map(v=>v.xl),...bracketbox.filter(v=>v.type.at(0)==='∫'&&intpos[i][0]<(v.yt+v.yb)/2&&(v.yt+v.yb)/2<intpos[i][1]&&v.xl<intpos[i][2]&&v.xr<intpos[i][2]).map(v=>v.xr));
                                let changed=false;
                                for(let iv=0;iv<eq.length;iv++){
                                    let cy=(eq[iv].ymax+eq[iv].ymin)/2;
                                    if(eq[iv].letter==='∫'&&eq[iv].xmin<intpos[i][2]&&intpos[i][0]<cy&&cy<intpos[i][1]&&eq[iv].xmin>maxleftint){
                                        changed=true;
                                        maxleftint=eq[iv].xmin;
                                    }
                                }
                                bracketbox.push({type:'∫'+i+"upper",
                                xl:changed?(maxleftint+intpos[i][2])/2:maxleftint,
                                xr:mininsideint===intpos[i][3]?intpos[i][3]:(intpos[i][2]+mininsideint)/2,
                                yb:intpos[i][0],
                                yt:Math.max(ytop,...minuspos.filter(v=>v[0]<intpos[i][2]&&v[1]>intpos[i][3]).map(v=>v[2])),
                                });
                                bracketbox.push({type:'∫'+i+"lower",
                                xl:changed?(maxleftint+intpos[i][2])/2:maxleftint,
                                xr:mininsideint===intpos[i][3]?intpos[i][3]:(intpos[i][2]+mininsideint)/2,
                                yb:Math.min(ybottom,...minuspos.filter(v=>v[0]<intpos[i][2]&&v[1]>intpos[i][3]).map(v=>v[2])),
                                yt:intpos[i][1],
                                });
                                break
                            }
                        }
                    }
                }
                if(intpos[i].length>3){
                    break
                }
            }
        }
    }

    //sort vertical
    let ybaseline=[];
    for(let i=0;i<eq.length;i++){
        let c=-1;
        for(let ii=0;ii<ybaseline.length;ii++){
            if(Math.abs(eq[i].baseline-ybaseline[ii][0]/(ybaseline[ii].length-1))<medianls/2){
                ybaseline[ii][0]+=eq[i].baseline;
                c=ii;
                ybaseline[ii].push(eq[i]);
                break
            }
        }
        if(c===-1){
            ybaseline.push([eq[i].baseline,eq[i]]);
        }
    }
    for(let i=0;i<ybaseline.length;i++){
        for(let ii=0;ii<functionnames.length;ii++){
            for(let iii=1;iii<ybaseline[i].length;iii++){
                let isfunc=true;
                let funci=-1;
                for(let iv=0;iv<functionnames[ii].length;iv++){
                    if(ybaseline[i][iii+iv]===undefined||functionnames[ii][iv]!==(ybaseline[i][iii+iv].letter==='0'?'o':ybaseline[i][iii+iv].letter)){
                        isfunc=false;
                        break
                    }
                    if(isfunc&&iv==functionnames[ii].length-1){
                        funci=ii;
                    }
                }
                if(isfunc){
                    let prop={letter:functionnames[funci],
                    xmax:ybaseline[i][iii+functionnames[funci].length-1].xmax,
                    ymax:Math.max(...ybaseline[i].filter((v,vi)=>iii<=vi&&vi<iii+functionnames[funci].length).map(v=>v.ymax)),
                    xmin:ybaseline[i][iii].xmin,
                    ymin:Math.min(...ybaseline[i].filter((v,vi)=>iii<=vi&&vi<iii+functionnames[funci].length).map(v=>v.ymin)),
                    midline:ybaseline[i].filter((v,vi)=>iii<=vi&&vi<iii+functionnames[funci].length).map(v=>v.midline).reduce((pv,cv)=>pv+cv,0),
                    baseline:ybaseline[i].filter((v,vi)=>iii<=vi&&vi<iii+functionnames[funci].length).map(v=>v.baseline).reduce((pv,cv)=>pv+cv,0),
                    }
                    prop.midline/=functionnames[funci].length;
                    prop.baseline/=functionnames[funci].length;
                    ybaseline[i].splice(iii,functionnames[funci].length,prop);
                }
            }
        }
    }
    eq=ybaseline.map(v=>v.filter((v,i)=>i>0)).flat();
    bracketbox.sort((a,b)=>{
        if(a.type.at(0)==='∫'&&b.type.at(0)==='∫'&&((a.type.includes('lower')||a.type.includes('upper'))&&!(b.type.includes('lower')||b.type.includes('upper'))||!(a.type.includes('lower')||a.type.includes('upper'))&&(b.type.includes('lower')||b.type.includes('upper')))){
            if(a.type.includes('lower')||a.type.includes('upper')&&!(b.type.includes('lower')||b.type.includes('upper'))){
                return 1;
            }else{
                return -1;
            }
        }else{
            return (b.xr-b.xl)*(b.yb-b.yt)*(1+10*(b.type==='='||b.type==='all'))-(a.xr-a.xl)*(a.yb-a.yt)*(1+10*(a.type==='='||a.type==='all'));
        }
    });
    for(let i=bracketbox.length-1;i>=0;i--){
        let fraclines=[];
        for(let ii=0;ii<minuspos.length;ii++){
            if(minuspos[ii][2]<=bracketbox[i].yb&&minuspos[ii][2]>=bracketbox[i].yt&&minuspos[ii][0]>=bracketbox[i].xl&&minuspos[ii][1]<=bracketbox[i].xr){
                fraclines.push(minuspos[ii])
            }
        }
        fraclines=[[bracketbox[i].xl,bracketbox[i].xr,bracketbox[i].yt],...fraclines,[bracketbox[i].xl,bracketbox[i].xr,bracketbox[i].yb]]
        let t=[];
        for(let ii=eq.length-1;ii>=0;ii--){
            let xc=(eq[ii].xmax+eq[ii].xmin)/2;
            let yc=(eq[ii].ymax+eq[ii].ymin)/2;
            if(bracketbox[i].xl<=xc&&xc<=bracketbox[i].xr&&bracketbox[i].yt<=yc&&yc<=bracketbox[i].yb){
                t.push(eq[ii]);
                eq.splice(ii,1);
            }
        }
        t.sort((a,b)=>(a.xmax+a.xmin)/2-(b.xmax+b.xmin)/2);
        for(let ii=0;ii<fraclines.length-1;ii++){
            tt=[];
            for(let iii=t.length-1;iii>=0;iii--){
                let xc=(t[iii].xmax+t[iii].xmin)/2;
                let yc=(t[iii].ymax+t[iii].ymin)/2;
                if(yc>=fraclines[ii][2]&&yc<=fraclines[ii+1][2]&&xc>=fraclines[ii][0]&&xc<=fraclines[ii][1]&&xc>=fraclines[ii+1][0]&&xc<=fraclines[ii+1][1]){
                    let isdiv=false;
                    for(let iv=0;iv<minuspos.length;iv++){
                        if(t[iii].xmin===minuspos[iv][0]&&t[iii].xmax===minuspos[iv][1]&&(t[iii].ymax+t[iii].ymin)/2===minuspos[iv][2]){
                            isdiv=true;
                            break
                        }
                    }
                    isdiv=isdiv&&t[iii].letter==='-';
                    if(!(isdiv||t[iii].letter==='√')){
                        tt.push(t[iii]);
                    }
                    t.splice(iii,1);
                }
            }
            tt.sort((a,b)=>(a.xmax+a.xmin)/2-(b.xmax+b.xmin)/2);
            //look for powers
            let upi=[];
            let upbaseline=[];
            let superscriptss=.66;
            for(let iii=1;iii<tt.length;iii++){
                let istimesdiv=tt[iii].letter.at(0)==='*'||tt[iii].letter.at(0)==='/'||tt[iii].letter.at(0)==='/'||tt[iii].letter.at(0)==='÷';
                let isplusmunus=tt[iii].letter.at(0)==='+'||tt[iii].letter.at(0)==='-';
                let notallowpowafter=tt[iii-1].letter.at(-1)==='∫'||tt[iii-1].letter.at(-1)==='+'||tt[iii-1].letter.at(-1)==='-'||tt[iii-1].letter.at(-1)==='*'||tt[iii-1].letter.at(-1)==='/'||tt[iii-1].letter.at(-1)==='÷'||tt[iii-1].letter.at(-1)===','||tt[iii-1].letter.at(-1)==='.'||tt[iii-1].letter.at(-1)==='('||tt[iii-1].letter.at(-1)==='=';
                let dontgotopoweron=istimesdiv||tt[iii].letter.at(0)==='^'||tt[iii].letter.at(0)==='='||tt[iii].letter.at(0)===')';
                let newbaseline=superscriptss*(tt[iii-1].baseline-tt[iii-1].ymin)+tt[iii-1].ymin;
                let uplikepow=tt[iii].baseline<newbaseline;
                if(!(notallowpowafter||dontgotopoweron)&&(!isplusmunus&&uplikepow&&tt[iii-1].ymax>tt[iii].ymax||(isplusmunus&&tt[iii+1]!=undefined&&tt[iii+1].baseline<superscriptss*(tt[iii-1].baseline-tt[iii-1].ymin)+tt[iii-1].ymin&&tt[iii-1].ymax>tt[iii+1].ymax))){
                    upi.push(iii);
                    upbaseline.push(newbaseline);
                }
                for(let iv=0;iv<upi.length;iv++){
                    if(upi[iv]<iii&&(!Array.isArray(upi[iv])&&(tt[iii].baseline>upbaseline[iv]||isplusmunus&&tt[upi[iv]].ymax<tt[iii].ymin))){
                        upi[iv]=[upi[iv],iii-1];
                    }
                }
            }
            line=''
            for(let iii=0;iii<tt.length;iii++){
                for(let iv=0;iv<upi.length;iv++){
                    if(upi[iv]===iii||upi[iv][0]===iii){
                        line+='^(';
                        break
                    }
                }
                line+=tt[iii].letter;
                for(let iv=0;iv<upi.length;iv++){
                    if(Array.isArray(upi[iv])&&upi[iv][1]===iii){
                        line+=')';
                    }
                }
            }
            cb=0;
            for(let iii=0;iii<line.length;iii++){
                if(line[iii]==='('){
                    cb+=1;
                }else if(line[iii]===')'){
                    cb-=1;
                }
            }
            for(let iii=0;iii<cb;iii++){
                line+=')';
            }
            for(let iii=cb;iii<0;iii++){
                line='('+line;
            }
            if(line!==''){
                let prop={letter:line,
                xmax:Math.max(...tt.map(v=>v.xmax)),
                ymax:Math.max(...tt.map(v=>v.ymax)),
                xmin:Math.min(...tt.map(v=>v.xmin)),
                ymin:Math.min(...tt.map(v=>v.ymin)),
                midline:tt.map(v=>v.midline).reduce((pv,cv)=>pv+cv,0)/tt.length,
                baseline:Math.max(...tt.filter(v=>!(v.letter==='('||v.letter===')')).map(v=>v.baseline)),
                }
                t.push(prop);
                t.sort((a,b)=>(a.xmax+a.xmin)/2-(b.xmax+b.xmin)/2);
            }
        }
        for(let ii=minuspos.length-1;ii>=0;ii--){
            let fractop=[];
            let fracbot=[];
            for(let iii=t.length-1;iii>=0;iii--){
                let xmid=(t[iii].xmax+t[iii].xmin)/2;
                let ymid=(t[iii].ymax+t[iii].ymin)/2;
                if(xmid>=minuspos[ii][0]&&xmid<=minuspos[ii][1]){
                    ymid<minuspos[ii][2]?fractop.push(t[iii]):fracbot.push(t[iii]);
                    t.splice(iii,1);
                }
            }
            if(fractop.length>0&&fracbot.length>0){
                let prop={letter:'('+fractop.map(v=>v.letter).join('')+')/('+fracbot.map(v=>v.letter).join('')+')',
                xmax:Math.max(...fractop.map(v=>v.xmax),...fracbot.map(v=>v.xmax)),
                ymax:Math.max(...fractop.map(v=>v.ymax),...fracbot.map(v=>v.ymax)),
                xmin:Math.min(...fractop.map(v=>v.xmin),...fracbot.map(v=>v.xmin)),
                ymin:Math.min(...fractop.map(v=>v.ymin),...fracbot.map(v=>v.ymin)),
                midline:minuspos[ii][2],
                baseline:Math.max(...fractop.map(v=>v.baseline)),
                }
                t.push(prop);
                minuspos.splice(ii,1)
            }else{
                t.push(...fractop,...fracbot);
            }
            t.sort((a,b)=>(a.xmax+a.xmin)/2-(b.xmax+b.xmin)/2);
        }
        if(bracketbox[i].type[0]==='√'&&t.length===1){
            t[0].letter='('+t[0].letter+')^(1/2)';
        }else if(bracketbox[i].type[0]==='√'&&eq.length===0&&t.length===0){
            t[0]={letter:'^(1/2)'};
        }
        if(bracketbox[i].type[0]==='∫'&&t.length===1&&!(bracketbox[i].type.includes('lower')||bracketbox[i].type.includes('upper'))){
            let intnumb=Number(bracketbox[i].type.slice(1));
            let lower='';
            let upper='';
            for(let ii=i+1;ii<bracketbox.length;ii++){
                if(bracketbox[ii].type==='∫'+intnumb+'lower'){
                    for(let iii=0;iii<eq.length;iii++){
                        let xc=(eq[iii].xmin+eq[iii].xmax)/2;
                        let yc=(eq[iii].ymin+eq[iii].ymax)/2;
                        if(bracketbox[ii].xl<xc&&xc<bracketbox[ii].xr&&bracketbox[ii].yt<yc&&yc<bracketbox[ii].yb){
                            lower=eq[iii].letter;
                            eq.splice(iii,1);
                            break
                        }
                    }
                }
                if(bracketbox[ii].type==='∫'+intnumb+'upper'){
                    for(let iii=0;iii<eq.length;iii++){
                        let xc=(eq[iii].xmin+eq[iii].xmax)/2;
                        let yc=(eq[iii].ymin+eq[iii].ymax)/2;
                        if(bracketbox[ii].xl<xc&&xc<bracketbox[ii].xr&&bracketbox[ii].yt<yc&&yc<bracketbox[ii].yb){
                            upper=eq[iii].letter;
                            eq.splice(iii,1);
                            break
                        }
                    }
                }
            }
            t[0].letter=t[0].letter.replace(/\^\(([^)]+)\)$/g, '$1');
            t[0].letter=t[0].letter.replace('∫','int(');
            let intbeforend=t[0].letter.slice(0,t[0].letter.length-2);
            if(lower!==''||upper!==''){
                t[0].letter=intbeforend+','+intpos[intnumb][4].letter+','+lower+','+upper+')';
            }else{
                t[0].letter=intbeforend+','+intpos[intnumb][4].letter+')';
            }
        }
        eq.push(...t);
    }


    let word=''
    for(let i=0;i<eq.length;i++){
        word+=eq[i].letter+' ';
    }
    
    let diffs=word.match(/\(d[^ \d]\)\/\(d[^ \d]\)/g);
    if(diffs!==null){
        for(let i=0;i<diffs.length;i++){
            word=word.replace(diffs,'diff('+diffs[i][2]+','+diffs[i][7]+')');
        }
    }
    diffs=/\(d\)\/\(d[^ \d]\)/g;
    let torep=[];
    while((match = diffs.exec(word)) !== null) {
        let remaining=word.slice(match.index+match[0].length);
        let inbrac=getbetweenbrac(remaining);
        if(inbrac!==undefined){
            torep.push([match[0]+inbrac[1][0]+inbrac[0]+inbrac[1][1],'diff('+inbrac[0]+','+match[0][6]+')']);
        }
    }
    for(let r of torep){
        word=word.replace(r[0],r[1]);
    }
    word=word.replaceAll("÷","/");
    for(let i=0;i<functionnames.length;i++){
        if(functionnames[i].includes('o')){
            word=word.replaceAll(functionnames[i].replaceAll('o','0'),functionnames[i]);
        }
        // word=word.replaceAll(functionnames[i]+'1',functionnames[i]+'(');
        // word=word.replaceAll(functionnames[i]+'l',functionnames[i]+'(');
        // word=word.replaceAll(functionnames[i]+'c',functionnames[i]+'(');
    }

    document.getElementById("input").value=word;
    eqinput.readinput('input','errors','inputdisplay')
    return word;
    // document.getElementById("word").innerHTML=word;
}
