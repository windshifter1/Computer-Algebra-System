function getpropfrompoint(x,y,points,maxedgespace){
    let nangles=25;
    let ang=linspace(0,Math.PI-Math.PI/nangles,nangles);
    let xb=[];
    let yb=[];
    let A;
    for(let ii=0;ii<2;ii++){
        xb=[];
        yb=[];
        let xbp=[];
        let ybp=[];
        let xbn=[];
        let ybn=[];
        for(let i=0;i<nangles;i++){
            let [pd,nd]=dist2intersect(x,y,ang[i],points);
            xbp[i]=x+pd*Math.cos(ang[i]);
            ybp[i]=y+pd*Math.sin(ang[i]);
            xbn[i]=x+nd*Math.cos(ang[i]);
            ybn[i]=y+nd*Math.sin(ang[i]);
        }
        xb=[...xbp,...xbn];
        yb=[...ybp,...ybn];
        [x,y,A]=centroidarea(xb.filter(x=>isFinite(x)),yb.filter(x=>isFinite(x)));
    }
    if(A===0||!isFinite(x)||!isFinite(y)||!isFinite(A)){
        return {"x":x,"y":y,"A":A,"ang":ang,"xb":xb,"yb":yb}
    }
    xb=xb.filter(x=>isFinite(x));
    yb=yb.filter(x=>isFinite(x));
    ang=xb.map((v,i)=>Math.atan2(yb[i]-y,xb[i]-x));
    ang=ang.map(v=>v<0?v+2*Math.PI:v);
    reorder=ang.map((v,i)=>i);
    reorder.sort((a,b)=>ang[a]-ang[b]);
    ang=reorder.map((i)=>ang[i]);
    xb=reorder.map((i)=>xb[i]);
    yb=reorder.map((i)=>yb[i]);
    ang=[ang[ang.length-1]-2*Math.PI,...ang,ang[0]+2*Math.PI];
    xb=[xb[xb.length-1],...xb,xb[0]];
    yb=[yb[yb.length-1],...yb,yb[0]];
    //place point just next to edge of section
    for(let i=0;i<ang.length-1;i++){
        if(ang[i+1]-ang[i]>Math.PI/(nangles-1)){
            let av=(ang[i+1]+ang[i])/2;
            let [dp,dn]=dist2intersect(x,y,av,points);
            ang=[...ang.slice(0,i+1),av,...ang.slice(i+1)];
            xb=[...xb.slice(0,i+1),x+dp*Math.cos(av),...xb.slice(i+1)];
            yb=[...yb.slice(0,i+1),y+dp*Math.sin(av),...yb.slice(i+1)];
        }
    }
    for(let i=0;i<ang.length-1;i++){
        if(isFinite(xb[i])&&!isFinite(xb[i+1])){
            let lb=ang[i];
            let ub=ang[i+1];
            let dist=((xb[i]-x)**2+(yb[i]-y)**2)**.5;
            for(let ii=0;ii<100;ii++){
                let av=(lb+ub)/2;
                let [dp,dn]=dist2intersect(x,y,av,points);
                if(!isFinite(dp)){
                    ub=av;
                }else{
                    lb=av;
                    dist=dp;
                }
                if(ub-lb<.001){
                    break
                }
            }
            ang=[...ang.slice(0,i+1),lb,ub,...ang.slice(i+1)];
            xb=[...xb.slice(0,i+1),x+dist*Math.cos(lb),Number.POSITIVE_INFINITY,...xb.slice(i+1)];
            yb=[...yb.slice(0,i+1),y+dist*Math.sin(lb),Number.POSITIVE_INFINITY,...yb.slice(i+1)];
            i++;
        }else if(!isFinite(xb[i])&&isFinite(xb[i+1])){
            let lb=ang[i];
            let ub=ang[i+1];
            let dist=((xb[i+1]-x)**2+(yb[i+1]-y)**2)**.5;
            for(let ii=0;ii<100;ii++){
                let av=(lb+ub)/2;
                let [dp,dn]=dist2intersect(x,y,av,points);
                if(isFinite(dp)){
                    ub=av;
                    dist=dp;
                }else{
                    lb=av;
                }
                if(ub-lb<.001){
                    break
                }
            }
            ang=[...ang.slice(0,i+1),lb,ub,...ang.slice(i+1)];
            xb=[...xb.slice(0,i+1),Number.POSITIVE_INFINITY,x+dist*Math.cos(ub),...xb.slice(i+1)];
            yb=[...yb.slice(0,i+1),Number.POSITIVE_INFINITY,y+dist*Math.sin(ub),...yb.slice(i+1)];
            i++;
        }
    }
    let startfinite=[];
    let endfinite=[];
    for(let i=0;i<xb.length-1;i++){
        if(isFinite(xb[i])&&!isFinite(xb[i+1])){
            endfinite.push([xb[i],yb[i]]);
        }else if(!isFinite(xb[i])&&isFinite(xb[i+1])){
            startfinite.push([xb[i+1],yb[i+1]]);
        }
    }
    xb=xb.filter((v,i)=>ang[i]>=0&&ang[i]<2*Math.PI&&isFinite(xb[i]));
    yb=yb.filter((v,i)=>ang[i]>=0&&ang[i]<2*Math.PI&&isFinite(yb[i]));
    [x,y,A]=centroidarea(xb.filter(x=>isFinite(x)),yb.filter(x=>isFinite(x)));
    ang=xb.map((v,i)=>Math.atan2(yb[i]-y,xb[i]-x));
    ang=ang.map(v=>v<0?v+2*Math.PI:v);
    reorder=ang.map((v,i)=>i);
    reorder.sort((a,b)=>ang[a]-ang[b]);
    ang=reorder.map((i)=>ang[i]);
    xb=reorder.map((i)=>xb[i]);
    yb=reorder.map((i)=>yb[i]);
    let checkeddist=false;
    if(startfinite.length>0&&endfinite.length>0){
        checkeddist=true;
        //close large gaps if possible
        for(let i=0;i<xb.length-1;i++){
            let dist=((xb[i+1]-xb[i])**2+(yb[i+1]-yb[i])**2)**.5;
            if(dist>maxedgespace){
                let av=(ang[i]+ang[i+1])/2;
                let [dp,dn]=dist2intersect(x,y,av,points);
                if(isFinite(dp)){
                    ang=[...ang.slice(0,i+1),av,...ang.slice(i+1)];
                    xb=[...xb.slice(0,i+1),x+dp*Math.cos(av),...xb.slice(i+1)];
                    yb=[...yb.slice(0,i+1),y+dp*Math.sin(av),...yb.slice(i+1)];
                }else{
                    continue
                }
                if(ang[i+1]-ang[i]>1e-8){
                    i--;
                }else if(ang[i+1]-ang[i]<=1e-8){
                    i++;
                }
            }
        }
        //remove pioints going through boundary
        for(let i=0;i<xb.length-1;i++){
            let dist=((xb[i+1]-xb[i])**2+(yb[i+1]-yb[i])**2)**.5;
            if(dist>maxedgespace&&ang[i+1]-ang[i]<=1e-8){
                for(let ii=i+1;ii<xb.length;ii++){
                    if(ang[ii]-ang[i]>=Math.PI/(nangles)){
                        break
                    }
                    let distskip=((xb[ii]-xb[i])**2+(yb[ii]-yb[i])**2)**.5;
                    if(distskip<=maxedgespace){
                        ang.splice(i+1,ii-i-1);
                        xb.splice(i+1,ii-i-1);
                        yb.splice(i+1,ii-i-1);
                        break
                    }
                }
            }
        }
        for(let i=0;i<xb.length-1;i++){
            let dist=((xb[i+1]-xb[i])**2+(yb[i+1]-yb[i])**2)**.5;
            if(dist>maxedgespace&&ang[i+1]-ang[i]<=1e-8){
                let gapi=((xb[i+1]-xb[i])**2+(yb[i+1]-yb[i])**2)**.5>((xb[i+2]-xb[i+1])**2+(yb[i+2]-yb[i+1])**2)**.5?0:1;
                let startopeni;
                let endopeni;
                for(let i=0;i<xb.length;i++){
                    if(startfinite.filter(v=>v[0]===xb[i]&&v[1]===yb[i]).length>0){
                        endopeni=i;
                    }
                    if(endfinite.filter(v=>v[0]===xb[i]&&v[1]===yb[i]).length>0){
                        startopeni=i;
                    }
                }
                // console.log("S:"+startopeni+" E:"+endopeni);
                if(endopeni<i+gapi&&startopeni>i+gapi){
                    let angbefore=ang[i+gapi]-ang[endopeni];
                    let angafter=ang[startopeni]-ang[i+gapi+1];
                    if(angbefore>angafter){
                        endfinite.push([xb[i+gapi],yb[i+gapi]]);
                        ang.splice(i+gapi+1);
                        xb.splice(i+gapi+1);
                        yb.splice(i+gapi+1);
                        // debugger
                    }else{
                        startfinite.push([xb[i+gapi+1],yb[i+gapi+1]]);
                        ang.splice(0,i+gapi+1);
                        xb.splice(0,i+gapi+1);
                        yb.splice(0,i+gapi+1);
                        // debugger
                    }
                }else if(i<startopeni){
                    let angbefore=ang[i+gapi]+2*Math.PI-ang[endopeni];
                    let angafter=ang[startopeni]-ang[i+gapi+1];
                    if(angbefore>angafter){
                        endfinite.push([xb[i+gapi],yb[i+gapi]]);
                        ang.splice(i+gapi+1,startopeni-(i+gapi));
                        xb.splice(i+gapi+1,startopeni-(i+gapi));
                        yb.splice(i+gapi+1,startopeni-(i+gapi));
                        // debugger
                    }else{
                        startfinite.push([xb[i+gapi+1],yb[i+gapi+1]]);
                        ang.splice(endopeni);
                        xb.splice(endopeni);
                        yb.splice(endopeni);
                        ang.splice(0,i+gapi+1);
                        red=xb.splice(0,i+gapi+1);
                        yb.splice(0,i+gapi+1);
                        // debugger
                    }
                }else if(i>=endopeni){
                    let angbefore=ang[i+gapi]-ang[endopeni];
                    let angafter=2*Math.PI-ang[i+gapi+1]+ang[startopeni];
                    if(angbefore>angafter){
                        endfinite.push([xb[i+gapi],yb[i+gapi]]);
                        ang.splice(i+gapi+1);
                        xb.splice(i+gapi+1);
                        yb.splice(i+gapi+1);
                        ang.splice(0,startopeni+1);
                        xb.splice(0,startopeni+1);
                        yb.splice(0,startopeni+1);
                        // debugger
                    }else{
                        startfinite.push([xb[i+gapi+1],yb[i+gapi+1]]);
                        ang.splice(endopeni,i+gapi-endopeni+1);
                        xb.splice(endopeni,i+gapi-endopeni+1);
                        yb.splice(endopeni,i+gapi-endopeni+1);
                        // debugger
                    }
                }
            }
        }
    }
    [x,y,A]=centroidarea(xb.filter(x=>isFinite(x)),yb.filter(x=>isFinite(x)));
    ang=xb.map((v,i)=>Math.atan2(yb[i]-y,xb[i]-x));
    ang=ang.map(v=>v<0?v+2*Math.PI:v);
    for(let i=0;i<xb.length;i++){
        if(startfinite.filter(v=>v[0]===xb[i]&&v[1]===yb[i]).length>0){
            ang.splice(i,0,ang[i]-Number.EPSILON*10);
            xb.splice(i,0,Number.POSITIVE_INFINITY);
            yb.splice(i,0,Number.POSITIVE_INFINITY);
            i++;
            // debugger
        }
        if(endfinite.filter(v=>v[0]===xb[i]&&v[1]===yb[i]).length>0){
            ang.splice(i+1,0,ang[i]+Number.EPSILON*10);
            xb.splice(i+1,0,Number.POSITIVE_INFINITY);
            yb.splice(i+1,0,Number.POSITIVE_INFINITY);
            // debugger
        }
    }
    let alldistbelowmax=true;
    if(checkeddist){
        for(let i=0;i<xb.length-1;i++){
            if(Number.isFinite(xb[i])&&Number.isFinite(xb[i+1])){
                let dist=((xb[i+1]-xb[i])**2+(yb[i+1]-yb[i])**2)**.5;
                if(dist>maxedgespace){
                    A=0;
                }
            }
        }
    }
    return {"x":x,"y":y,"A":A,"ang":ang,"xb":xb,"yb":yb}
}
async function workoutchar(points){
    const isnani=[];
    points.x.forEach((x,i)=>isNaN(x)?isnani.push(i):'');
    const x=points.x.filter(x=>Number.isFinite(x));
    const y=points.y.filter(y=>Number.isFinite(y));
    const xmin=Math.min(...x);
    const xmax=Math.max(...x);
    const ymin=Math.min(...y);
    const ymax=Math.max(...y);
    let totallength=0;
    for(let i=0;i<x.length-1;i++){
        totallength+=Math.sqrt(Math.pow(x[i+1]-x[i],2)+Math.pow(y[i+1]-y[i],2));
    }
    // console.log(totallength,6*(ymax-ymin+xmax-xmin))
    if(totallength>6*(ymax-ymin+xmax-xmin)){
    //     points.x=[];
    //     points.y=[];
    //     ctx.clearRect(0, 0, canvas.width, canvas.height);
    //     document.getElementById("result").innerHTML="";
        return "delete"
    }
    //work out straight line letters
    let [ratioaway,ang,xstart,ystart,linelength]=lineminperpendiculardist(x,y);
    if(ratioaway<.08){
        if(ang<=Math.PI/8||ang>=7*Math.PI/8){
            console.log('-');
            return '-';
        }else if(Math.PI/8<ang&&ang<3*Math.PI/8){
            console.log('\\');
            return '\\';
        }else if(5*Math.PI/8<ang&&ang<7*Math.PI/8){
            console.log('/');
            return '/';
        }else{
            let maxsec=[ymin];
            let minsec=[ymax];
            let ci=0;
            for(let i=0;i<points.y.length;i++){
                if(Number.isFinite(points.y[i])){
                    if(points.y[i]>maxsec[ci]){
                        maxsec[ci]=points.y[i];
                    }
                    if(points.y[i]<minsec[ci]){
                        minsec[ci]=points.y[i];
                    }
                }else if(Number.isFinite(points.y[i-1])){
                    if(i!==points.y.length-1){
                        ci++;
                        maxsec.push(ymin);
                        minsec.push(ymax);
                    }
                }
            }
            for(let i=0;i<maxsec.length;i++){
                for(let ii=maxsec.length-1;ii>i;ii--){
                    if(Math.abs(maxsec[i]-maxsec[ii])<.1*(ymax-ymin)&&Math.abs(minsec[i]-minsec[ii])<.1*(ymax-ymin)){
                        maxsec.splice(ii,1);
                        minsec.splice(ii,1);
                    }
                }
            }
            let botofdoti=maxsec.reduce((pv,cv,i,arr)=>cv<arr[pv]?i:pv,0);
            if(minsec.filter((v,i)=>i!==botofdoti).length>0&&Math.min(...minsec.filter((v,i)=>i!==botofdoti))-maxsec[botofdoti]>(ymax-ymin)/100){
                console.log('i');
                return "i";
            }else{
                console.log('1');
                return "1";
            }
        }
    }
    let input=getinputfornn(points)[0];
    // console.log(input);
    // let wb=JSON.parse(localStorage.getItem("wb"));
    let wb=await compressedlocalstorage2obj('wb');
    if(wb!==null&&wb.w[0][0].length===input.length&&wb.b[wb.b.length-1].length===i2letter.length){
        let prob=classifier(input,wb.w,wb.b);
        let letter=i2letter[prob.indexOf(Math.max(...prob))];
        console.log(letter,Math.max(...prob));
        return letter;
    }else{
        localStorage.removeItem("wb");
        localStorage.removeItem("trainingdata");
        loadwb();
        console.log("The model parameters w and b are not the correct size.");
    }
}
function getinputfornn(points){
    const x=points.x.filter(x=>Number.isFinite(x));
    const y=points.y.filter(y=>Number.isFinite(y));
    const xmin=Math.min(...x);
    const xmax=Math.max(...x);
    const ymin=Math.min(...y);
    const ymax=Math.max(...y);
    const h=convexhull(x,y);
    let meanxy=[0,0];
    const verts=[...new Set(h.flat())];
    for(let i=0;i<verts.length;i++){
        meanxy[0]+=x[verts[i]];
        meanxy[1]+=y[verts[i]];
    }
    meanxy[0]/=verts.length;
    meanxy[1]/=verts.length;
    const hpoly=[...new Set(h.flat())].map((v)=>[x[v],y[v]]);
    hpoly.sort((a,b)=>Math.atan2(a[1]-meanxy[1],a[0]-meanxy[0])-Math.atan2(b[1]-meanxy[1],b[0]-meanxy[0]));
    hpoly.push([...hpoly[0]]);
    const hA=area(hpoly.map(v=>v[0]),hpoly.map(v=>v[1]));
    let p=[];
    let sd=Math.sqrt((xmax-xmin)*(ymax-ymin))/20;
    if(sd===0){
        sd=Math.max((xmax-xmin),(ymax-ymin))/20;
    }
    let maxedgespace=3*sd;
    let failcount=0;
    while (failcount<40&&hA>0||p.length===0){
        let xtest=(xmax-xmin)*Math.random()+xmin;
        let ytest=(ymax-ymin)*Math.random()+ymin;
        let add=inpolygon(xtest,ytest,hpoly.map(v=>v[0]),hpoly.map(v=>v[1]));
        if(add){
            failcount++;
        }else{
            continue
        }
        for(let i=0;i<p.length;i++){
            let xb=p[i].xb.filter(v=>isFinite(v));
            let yb=p[i].yb.filter(v=>isFinite(v));
            if(inpolygon(xtest,ytest,xb,yb)){
                add=false;
                break
            }
        }
        if(!add){
            continue
        }
        let prop=getpropfrompoint(xtest,ytest,points,maxedgespace);
        if(!isFinite(prop.A)||prop.A<=0||!isFinite(prop.x)||!isFinite(prop.y)||!inpolygon(prop.x,prop.y,hpoly.map(v=>v[0]),hpoly.map(v=>v[1]))){
            add=false;
            continue
        }
        let xbprop=prop.xb.filter(v=>isFinite(v));
        let ybprop=prop.yb.filter(v=>isFinite(v));
        for(let i=0;i<p.length;i++){
            let xbp=p[i].xb.filter(v=>isFinite(v));
            let ybp=p[i].yb.filter(v=>isFinite(v));
            if(prop.A>p[i].A&&xmin<=prop.x&&prop.x<=xmax&&ymin<=prop.y&&prop.y<=ymax&&inpolygon(p[i].x,p[i].y,prop.xb,prop.yb)){
                p[i]=prop;
                xbp=prop.xb.filter(v=>isFinite(v));
                ybp=prop.yb.filter(v=>isFinite(v));
                console.log("replaced");
                add=false;
            }
            if(inpolygon(prop.x,prop.y,xbp,ybp)){
                add=false;
                break
            }
        }
        if(add){
            failcount=0;
            p.push(prop);
        }
    }
    p.sort((a,b)=>b.A-a.A);
    let input=new Array(45).fill(0);
    input[0]=(xmax-xmin)/(ymax-ymin);
    let arcs=[];
    for(let i=0;i<Math.min(4,p.length);i++){
        input[11*i+1]=p[i].A/hA;
        input[11*i+2]=(p[i].x-xmin)/(xmax-xmin);
        input[11*i+3]=(p[i].y-ymin)/(ymax-ymin);
        let sd=dist2intersect(p[i].x,p[i].y,-Math.PI/8,points)[0];
        let ed=dist2intersect(p[i].x,p[i].y,Math.PI/8,points)[0];
        // if(((p[i].x+sd*Math.cos(-Math.PI/8)-p[i].xb.filter((v,iii)=>p[i].ang[iii]>15*Math.PI/8)[0])**2+(p[i].y+sd*Math.sin(-Math.PI/8)-p[i].yb.filter((v,iii)=>p[i].ang[iii]>15*Math.PI/8)[0])**2)**.5>maxedgespace){
        //     sd=Number.POSITIVE_INFINITY;
        // }
        // if(((p[i].x+ed*Math.cos(Math.PI/8)-p[i].xb.filter((v,iii)=>p[i].ang[iii]>15*Math.PI/8).at(-1))**2+(p[i].y+ed*Math.sin(Math.PI/8)-p[i].yb.filter((v,iii)=>p[i].ang[iii]>15*Math.PI/8).at(-1))**2)**.5>maxedgespace){
        //     ed=Number.POSITIVE_INFINITY;
        // }
        let arcx=[p[i].x,p[i].x+sd*Math.cos(-Math.PI/8),...p[i].xb.filter((v,iii)=>p[i].ang[iii]>15*Math.PI/8),...p[i].xb.filter((v,iii)=>p[i].ang[iii]<Math.PI/8),p[i].x+ed*Math.cos(Math.PI/8)];
        let arcy=[p[i].y,p[i].y+sd*Math.sin(-Math.PI/8),...p[i].yb.filter((v,iii)=>p[i].ang[iii]>15*Math.PI/8),...p[i].yb.filter((v,iii)=>p[i].ang[iii]<Math.PI/8),p[i].y+ed*Math.sin(Math.PI/8)];
        let arcxneg=[p[i].x];
        let arcyneg=[p[i].y];
        let negang=[-Math.PI/8-10*Number.EPSILON];
        if(!isFinite(sd)){
            let d=dist2intersect(p[i].x,p[i].y,-Math.PI/8,{"x":hpoly.map(v=>v[0]),"y":hpoly.map(v=>v[1])})[0];
            arcxneg.push(p[i].x+d*Math.cos(-Math.PI/8));
            arcyneg.push(p[i].y+d*Math.sin(-Math.PI/8));
            negang.push(-Math.PI/8);
        }
        for(let ii=0;ii<p[i].ang.length;ii++){
            if(p[i].ang[ii]<Math.PI/8||p[i].ang[ii]>15*Math.PI/8){
                if(!isFinite(p[i].xb[ii])){
                    let d=dist2intersect(p[i].x,p[i].y,p[i].ang[ii],{"x":hpoly.map(v=>v[0]),"y":hpoly.map(v=>v[1])})[0];
                    arcxneg.push(p[i].x+d*Math.cos(p[i].ang[ii]));
                    arcyneg.push(p[i].y+d*Math.sin(p[i].ang[ii]));
                    negang.push(p[i].ang[ii]+(p[i].ang[ii]>Math.PI?-2*Math.PI:0));
                }
            }
        }
        if(!isFinite(ed)){
            let d=dist2intersect(p[i].x,p[i].y,Math.PI/8,{"x":hpoly.map(v=>v[0]),"y":hpoly.map(v=>v[1])})[0];
            arcxneg.push(p[i].x+d*Math.cos(Math.PI/8));
            arcyneg.push(p[i].y+d*Math.sin(Math.PI/8));
            negang.push(Math.PI/8);
        }
        arcxneg.push(p[i].x);
        arcyneg.push(p[i].y);
        negang.push(Math.PI/8+10*Number.EPSILON);
        reorder=negang.map((v,i)=>i);
        reorder.sort((a,b)=>negang[a]-negang[b]);
        negang=reorder.map((i)=>negang[i]);
        arcxneg=reorder.map((i)=>arcxneg[i]);
        arcyneg=reorder.map((i)=>arcyneg[i]);

        arcx=arcx.map((v)=>isFinite(v)?v:p[i].x);
        arcy=arcy.map((v)=>isFinite(v)?v:p[i].y);
        arcs.push({"x":arcx,"y":arcy,"nx":arcxneg,"ny":arcyneg});
        input[11*i+4]=(area(arcx,arcy)-area(arcxneg,arcyneg))/hA;
        for(let ii=0;ii<7;ii++){
            let angs=(2*ii+1)*Math.PI/8;
            let ange=(2*ii+3)*Math.PI/8;
            let sd=dist2intersect(p[i].x,p[i].y,angs,points)[0];
            let ed=dist2intersect(p[i].x,p[i].y,ange,points)[0];
            // if(((p[i].x+sd*Math.cos(angs)-p[i].xb.filter((v,iii)=>p[i].ang[iii]>angs&&p[i].ang[iii]<ange)[0])**2+(p[i].y+sd*Math.sin(angs)-p[i].yb.filter((v,iii)=>p[i].ang[iii]>angs&&p[i].ang[iii]<ange)[0])**2)**.5>2*maxedgespace){
            //     sd=Number.POSITIVE_INFINITY;
            // }
            // if(((p[i].x+ed*Math.cos(ange)-p[i].xb.filter((v,iii)=>p[i].ang[iii]>angs&&p[i].ang[iii]<ange).at(-1))**2+(p[i].y+ed*Math.sin(ange)-p[i].yb.filter((v,iii)=>p[i].ang[iii]>angs&&p[i].ang[iii]<ange).at(-1))**2)**.5>2*maxedgespace){
            //     ed=Number.POSITIVE_INFINITY;
            // }
            let arcx=[p[i].x,p[i].x+sd*Math.cos(angs),...p[i].xb.filter((v,iii)=>p[i].ang[iii]>angs&&p[i].ang[iii]<ange),p[i].x+ed*Math.cos(ange)];
            let arcy=[p[i].y,p[i].y+sd*Math.sin(angs),...p[i].yb.filter((v,iii)=>p[i].ang[iii]>angs&&p[i].ang[iii]<ange),p[i].y+ed*Math.sin(ange)];
            let arcxneg=[p[i].x];
            let arcyneg=[p[i].y];
            if(!isFinite(sd)){
                let d=dist2intersect(p[i].x,p[i].y,angs,{"x":hpoly.map(v=>v[0]),"y":hpoly.map(v=>v[1])})[0];
                arcxneg.push(p[i].x+d*Math.cos(angs));
                arcyneg.push(p[i].y+d*Math.sin(angs));
            }
            for(let ii=0;ii<p[i].ang.length;ii++){
                if(p[i].ang[ii]>angs&&p[i].ang[ii]<ange){
                    if(!isFinite(p[i].xb[ii])){
                        let d=dist2intersect(p[i].x,p[i].y,p[i].ang[ii],{"x":hpoly.map(v=>v[0]),"y":hpoly.map(v=>v[1])})[0];
                        arcxneg.push(p[i].x+d*Math.cos(p[i].ang[ii]));
                        arcyneg.push(p[i].y+d*Math.sin(p[i].ang[ii]));
                    }
                }
            }
            if(!isFinite(ed)){
                let d=dist2intersect(p[i].x,p[i].y,ange,{"x":hpoly.map(v=>v[0]),"y":hpoly.map(v=>v[1])})[0];
                arcxneg.push(p[i].x+d*Math.cos(ange));
                arcyneg.push(p[i].y+d*Math.sin(ange));
            }
            arcxneg.push(p[i].x);
            arcyneg.push(p[i].y);
            arcx=arcx.map((v)=>isFinite(v)?v:p[i].x);
            arcy=arcy.map((v)=>isFinite(v)?v:p[i].y);
            arcs.push({"x":arcx,"y":arcy,"nx":arcxneg,"ny":arcyneg});
            input[11*i+5+ii]=(area(arcx,arcy)-area(arcxneg,arcyneg))/hA;
        }
    }
    if(input.some(v=>!isFinite(v))||p.length===0){
        console.log("NEED TO FIX")
        debugger
        // getpropfrompoint(xmin+1,ymin+1,points,3*sd)
        // dist2intersect(xmin+1,ymin+1,0.1256637061435917,points)
        error("NAN in input to NN")
    }
    return [input,arcs,points]
}
function lineminperpendiculardist(u,v){
    function solvefort(t,u,v){
        let n=u.length;
        let sint=Math.sin(t);
        let cost=Math.cos(t);
        let sumsc=u.reduce((pv,cv,i)=>pv+sint*u[i]-cost*v[i],0);
        let r=(2*(sumsc**2*cost-u.reduce((pv,cv,i)=>pv+2*cost**2*u[i]*v[i]*sint*n+cost**3*n*u[i]**2-cost**3*n*v[i]**2+2*sumsc*u[i]*cost*sint-u[i]*v[i]*n*sint-2*cost**2*sumsc*v[i]-u[i]**2*cost*n+cost*v[i]**2*n+sumsc*v[i],0)))/(n*sint);
        return r;
    }
    function dsolvefort(t,u,v){
        let n=u.length;
        let sint=Math.sin(t);
        let cost=Math.cos(t);
        let sumsc=u.reduce((pv,cv,i)=>pv+sint*u[i]-cost*v[i],0);
        let sumscp=u.reduce((pv,cv,i)=>pv+cost*u[i]+sint*v[i],0);
        let dr=(2*(2*sint*cost*sumsc*sumscp-sumsc**2-sint*u.reduce((pv,cv,i)=>pv-3*cost**2*n*u[i]**2*sint+3*cost**2*n*v[i]**2*sint+6*(cost**3)*u[i]*v[i]*n+4*cost*sumsc*v[i]*sint+2*(sumscp)*u[i]*cost*sint+u[i]**2*sint*n-sint*v[i]**2*n+4*sumsc*u[i]*cost**2-2*(cost**2)*(sumscp)*v[i]-5*cost*n*u[i]*v[i]-2*sumsc*u[i]+(sumscp)*v[i],0)+cost*u.reduce((pv,cv,i)=>pv+2*(cost**2)*u[i]*v[i]*sint*n+(cost**3)*n*u[i]**2-cost**3*n*v[i]**2+2*sumsc*u[i]*cost*sint-u[i]*v[i]*n*sint-2*(cost**2)*sumsc*v[i]-(u[i]**2)*cost*n+cost*v[i]**2*n+sumsc*v[i],0)))/(sint**2*n);
        return dr;
    }
    if(Math.abs(Math.max(...v)-Math.min(...v))<1e-3){
        let ymid=v.reduce((pv,cv)=>pv+cv)/v.length;
        let linelen=Math.max(...u)-Math.min(...u);
        let ratioaway=Math.max(...v.map((p)=>Math.abs(p-ymid)))/(linelen);
        let ang=0;
        return [ratioaway,ang,Math.min(...u),ymid,linelen];
    }
    u=u.filter(val=>Number.isFinite(val));
    v=v.filter(val=>Number.isFinite(val));
    let restarts=0;
    let t;
    while(true){
        t=Math.PI*Math.random();
        let r
        let dr;
        for(let i=0;i<20;i++){
            r=solvefort(t,u,v);
            dr=dsolvefort(t,u,v);
            t=t-r/dr;
            if(Math.abs(r)<1e-7){
                break
            }
        }
        if(Math.abs(r)<1e-7&&dr>1e-7){
            break
        }
        restarts++;
    }
    let sint=Math.sin(t);
    let cost=Math.cos(t);
    let x=u.reduce((pv,cv,i)=>pv+sint*u[i]-cost*v[i],0)/(sint*u.length);
    let dfo=u.map((value,i)=>(u[i]-x)*cost+(v[i])*sint);
    let mindfo=Math.min(...dfo);
    let maxdfo=Math.max(...dfo);
    x+=mindfo*cost;
    y=mindfo*sint;
    let linelen=maxdfo-mindfo;
    let ax=u.map((value)=>value-x);
    let ay=v.map((value)=>value-y);
    let bx=-sint;
    let by=cost;
    let d=ax.map((value,i)=>Math.abs(ax[i]*bx+ay[i]*by));
    let maxd=Math.max(...d);
    let ratioaway=maxd/linelen;
    let subtr=Math.floor(t/Math.PI);
    let ang=(t-subtr*Math.PI);
    return [ratioaway,ang,x,y,linelen];
}
function randn(){
    let u=0;
    let v=0;
    while(u===0)u=Math.random();
    while(v===0)v=Math.random();
    return (-2*Math.log(u))**.5*Math.cos(2*Math.PI*v);
}
function randintunique(nwanted,ntotal,starti=0){
    //Fisher-Yates shuffle
    let list=new Array(ntotal).fill(0).map((v,i)=>i+starti);
    for(let i=ntotal-1;i>=1;i--){
        const j=Math.floor(Math.random()*(i+1));
        [list[i],list[j]]=[list[j],list[i]];
    }
    list.splice(nwanted);
    return list;
}
function sigmoid(x){
    return x.map(v=>1/(1+Math.exp(-v)));
}
function dsigmoid(x){
    return x.map((v)=>{
        let ex=Math.exp(-v);
        return ex/(1+ex)**2;
    });
}
function softmax(x){
    let ex=x.map((v)=>Math.exp(v));
    let sumex=x.reduce((pv,cv,i)=>pv+ex[i],0);
    return ex.map(v=>v/sumex);
}
function dsoftmax(x){
    let ex=x.map((v)=>Math.exp(v));
    let sumex=x.reduce((pv,cv,i)=>pv+ex[i],0);
    return ex.map((v)=>v/sumex-(v/sumex)**2);
}
function classifier(input,w,b){
    let output=transpose([input]);
    for(let i=0;i<w.length;i++){
        let wxb=mtimes(w[i],output).map((v,ii)=>v[0]+b[i][ii][0]);
        if(i<w.length-1){
            output=transpose([sigmoid(wxb)]);
        }else{
            output=softmax(wxb);
        }
    }
    return output;
}
function classifiertraining(input,w,b,truth){
    let a=[input];
    let z=[];
    for(let i=0;i<w.length;i++){
        z[i]=mtimes(w[i],a[i]).map((v,ii)=>v.map((vv)=>vv+b[i][ii][0]));
        if(i<w.length-1){
            a[i+1]=z[i].map(v=>sigmoid(v));
        }else{
            a[i+1]=transpose(transpose(z[i]).map(v=>softmax(v)));
        }
    }
    let delta=[];
    output=a[a.length-1];
    delta[w.length-1]=truth.map((v,i)=>v.map((vv,ii)=>output[i][ii]-vv));
    for(let k=w.length-2;k>=0;k--){
        let dsig=z[k].map(v=>dsigmoid(v));
        delta[k]=mtimes(transpose(w[k+1]),delta[k+1]).map((v,ii)=>v.map((vv,iii)=>vv*dsig[ii][iii]));
    }
    let dw=[];
    let db=[];
    for(let i=0;i<w.length;i++){
        db[i]=delta[i].map((v,i)=>v.reduce((pv,cv)=>pv+cv,0));
        dw[i]=[];
        for(let ii=0;ii<w[i].length;ii++){
            dw[i][ii]=[];
            for(let iii=0;iii<w[i][0].length;iii++){
                dw[i][ii][iii]=0;
                for(let iv=0;iv<input[0].length;iv++){
                    dw[i][ii][iii]+=delta[i][ii][iv]*a[i][iii][iv];
                }
            }
        }
    }
    return [output,dw,db];
}
function trainnn(wb,trainingdata,i2letter,epochs,messager){
    function errors(truth,output,w,l2regularization){
        let truthflat=truth.flat();
        let outputflat=output.flat();
        let error=truthflat.reduce((pv,cv,ii)=>pv-cv*(outputflat[ii]===0?-Number.MAX_VALUE/(truth[0].length+1):Math.log(outputflat[ii])),0);
        let wflat=w.flat(3);
        let objerror=error+.5*l2regularization*wflat.reduce((pv,cv)=>pv+cv**2,0);
        return [objerror,error];
    }
    let takestep=(w,b,eta,input,truth,l2regularization)=>{
        let wnew=structuredClone(w);
        let bnew=structuredClone(b);
        for(let i=0;i<w.length;i++){
            for(let ii=0;ii<w[i].length;ii++){
                bnew[i][ii][0]=b[i][ii][0]-eta*db[i][ii];
                for(let iii=0;iii<w[i][ii].length;iii++){
                    wnew[i][ii][iii]=w[i][ii][iii]-eta*(l2regularization*w[i][ii][iii]+dw[i][ii][iii]);
                }
            }
        }
        let [outputnew,dwnew,dbnew]=classifiertraining(input,wnew,bnew,truth);
        let [objerror,error]=errors(truth,outputnew,wnew,l2regularization);
        return [outputnew,dwnew,dbnew,wnew,bnew,objerror,error]
    }
    let w=wb.w;
    let b=wb.b;
    let input=transpose(trainingdata.map(v=>v[1]));
    let truth=new Array(i2letter.length).fill(0).map(v=>new Array(trainingdata.length).fill(0));
    for(let i=0;i<trainingdata.length;i++){
        truth[i2letter.indexOf(trainingdata[i][0])][i]=1;
    }
    let l2regularization=1e-4;
    let eta=1;
    let [output,dw,db]=classifiertraining(input,w,b,truth);
    let [objerror,error]=errors(truth,output,w,l2regularization);
    let errorold=Number.POSITIVE_INFINITY;
    for(let epoch=0;epoch<epochs;epoch++){
        if(epoch%20===0){
            console.log("epoch: "+epoch+", error: "+error+", objerror: "+objerror+" max grad: "+[...dw.flat(3).map(v=>Math.abs(v)),...db.flat(3).map(v=>Math.abs(v))].reduce((pv,cv)=>pv>cv?pv:cv,0));
        }
        if(epoch%335===99){
            for(let i=0;i<trainingdata.length;i++){
                trainingdata[i][1]=getinputfornn(trainingdata[i][2])[0];
            }
            input=transpose(trainingdata.map(v=>v[1]));
            errorold=Number.POSITIVE_INFINITY;
            eta=1;
            [output,dw,db]=classifiertraining(input,w,b,truth);
            [objerror,error]=errors(truth,output,w,l2regularization);
        }
        if(eta<1e-12){
            console.log('restart as step to small')
            errorold=Number.POSITIVE_INFINITY;
            eta=1;
            [output,dw,db]=classifiertraining(input,w,b,truth);
            [objerror,error]=errors(truth,output,w,l2regularization);
        }
        if(errorold-objerror<1e-10){
            console.log("Finished Training, Epochs: "+epoch+" Error: "+error+" objerror: "+objerror+" stepsize: "+eta)
            break
        }
        errorold=objerror;
        //linesearch
        //slope at 0
        let wflat=w.flat(3);
        let dwflat=dw.flat(3);
        let dwn=wflat.reduce((pv,cv,i)=>pv+(l2regularization*wflat[i]+dwflat[i])**2,0);
        let dbn=db.flat().reduce((pv,cv)=>pv+cv**2,0);
        let slope=(-(dwn+dbn));
        //value using prev eta
        let [output1,dw1,db1,w1,b1,objerror1,error1]=takestep(w,b,eta,input,truth,l2regularization);
        let etanew=-slope*eta**2/(2*(objerror1-objerror-slope*eta));
        if(etanew<0){
            etanew=2*eta;
        }
        //using new eta
        let [output2,dw2,db2,w2,b2,objerror2,error2]=takestep(w,b,etanew,input,truth,l2regularization);
        if(Math.min(objerror1,objerror2)<objerror){
            if(objerror1<objerror2){
                objerror=objerror1;
                error=error1;
                w=w1;
                b=b1;
                output=output1;
                dw=dw1;
                db=db1;
            }else{
                objerror=objerror2;
                error=error2;
                w=w2;
                b=b2;
                output=output2;
                dw=dw2;
                db=db2;
                eta=etanew;
            }
        }else{
            while(objerror1>objerror&&eta>1e-12){
                eta/=2;
                let [output1,dw1,db1,w1,b1,objerror1,error1]=takestep(w,b,eta,input,truth,l2regularization);
                if(objerror1<objerror){
                    objerror=objerror1;
                    error=error1;
                    w=w1;
                    b=b1;
                    output=output1;
                    dw=dw1;
                    db=db1;
                }
            }
        }
        if(messager!=undefined){
            messager.postMessage({status:"update",progress:`Updated model ${(epoch+1).toString()} of ${epochs}.`});
        }
    }
    wb.w=w;
    wb.b=b;
    console.log("Finished Training, Error: "+error+" objerror: "+objerror);
    return [wb,trainingdata];
}
async function obj2compressedlocalstorage(key,obj){
    obj=JSON.stringify(obj);
    const encoder = new TextEncoder();
    const byteArray = encoder.encode(obj);
    const stream = new Blob([byteArray]).stream().pipeThrough(new CompressionStream('gzip'));
    const buffer = await new Response(stream).arrayBuffer();
    const compressedBytes = new Uint8Array(buffer);
    let binaryString = '';
    const chunkSize = 65535;
    for (let i = 0; i < compressedBytes.length; i += chunkSize) {
        binaryString += String.fromCharCode.apply(null, compressedBytes.subarray(i, i + chunkSize));
    }
    localStorage.setItem(key,binaryString);
    return binaryString;
}
async function compressedlocalstorage2obj(name){
    name=localStorage.getItem(name);
    if(name===null){
        return null;
    }
    const len=name.length
    const bytes=new Uint8Array(len);
    for(let i=0;i<len;i++){
        bytes[i]=name.charCodeAt(i);
    }
    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
    const buffer = await new Response(stream).arrayBuffer();
    const decoder = new TextDecoder();
    return JSON.parse(decoder.decode(buffer));
}
async function readuserfile(){
    try{    
        const [fileHandle] = await window.showOpenFilePicker({
        types: [{
            description: 'Text Files',
            accept: { 'text/plain': ['.json'] }
        }],
        multiple: false
        });
        const file=await fileHandle.getFile();
        const headerSlice = file.slice(0,2);
        const headerBuffer = await headerSlice.arrayBuffer();
        const headerBytes = new Uint8Array(headerBuffer);
        const isGzip = headerBytes[0] === 0x1F && headerBytes[1] === 0x8B;
        let targetStream = file.stream();
        if(isGzip){
            targetStream = targetStream.pipeThrough(new DecompressionStream('gzip'));
        }
        const reader = targetStream.getReader();
        const decoder = new TextDecoder('utf-8');
        let accumulatedText = '';
        while (true) {
        const { done, value } = await reader.read();
        if (done) break;
            // 'value' is a Uint8Array containing the current text/data chunk
            accumulatedText += decoder.decode(value, { stream: true });
        }
        accumulatedText += decoder.decode();
        const jsonObject = JSON.parse(accumulatedText);
        reader.releaseLock();
        return jsonObject;
    }catch(error){
        progressmessages.innerHTML="File failed to load: "+error
    }
}
class WorkerQueue{
    constructor(){
        function genericworkercode(){
            self.onmessage=(e)=>{
                const {stringcode,mainfunction,args}=e.data;
                const tasktype=args.shift();
                const code=eval(stringcode);
                args.push(self);
                const result=code[mainfunction](...args);
                self.postMessage({status:"done",tasktype:tasktype,result:result});
            }
        }
        let blob=new Blob(["("+genericworkercode.toString()+")()"],{type:"text/javascript"});
        this.worker=new Worker(window.URL.createObjectURL(blob));
        this.queue = [];
        this.isWorkerBusy = false;
        this.worker.onerror=(e)=>{
            this.isWorkerBusy=false;
            this.processNext();
            console.log('Error detected in Worker:');
            console.log(`Message: ${e.message}`);
            console.log(`File: ${e.filename}`);
            console.log(`Line: ${e.lineno}, Column: ${e.colno}`);
        }
        // Set up the listener to process the next job when the worker finishes
        this.worker.onmessage = async (e) => {
            if(e.data.status==='done'){
                this.isWorkerBusy = false;
                this.processNext();
                if(e.data.tasktype==="restore default"){
                    await obj2compressedlocalstorage("trainingdata",e.data.result);
                }else if(e.data.tasktype==='train'){
                    let wb=e.data.result[0];
                    let trainingdata=e.data.result[1];
                    await obj2compressedlocalstorage("wb",wb);
                    await obj2compressedlocalstorage("trainingdata",trainingdata);
                }
            }else if(e.data.status==='update'){
                progressmessages.innerHTML=e.data.progress;
            }
        };
    }
    addTask(data){
        // Drop task if the current queue has 2 or more items waiting
        if(this.queue.length >= 1) {
            return false; 
        }
        this.queue[0]=data;
        this.processNext();
        return true;
    }
    processNext(){
        if (this.isWorkerBusy || this.queue.length === 0) return;
        this.isWorkerBusy = true;
        const nextTask = this.queue.shift();
        this.worker.postMessage(nextTask);
    }
    // terminate() {
    //     this.worker.terminate();
    // }
}
const workerque=new WorkerQueue();
function plot(x,y){
    if(y==undefined){
        if(x[0].length===2){
            y=x.map(v=>-v[1]);
            x=x.map(v=>v[0]);
        }
    }
    graph_data = {
        "kind": {"plotly":true}, 
        "data": [
            {
                "mode": "lines",
                "type": "scatter",
                "x": x,
                "y": y,
            }
        ],
        "layout":{
            "xaxis":{
                "scaleanchor": 'y',
                "scaleratio": 1,
            },
            "yaxis":{
                
            },
        }
    }
    return graph_data;
}