const canvascurrentletter=document.createElement('canvas');
canvascurrentletter.style.display='block';
canvascurrentletter.style.width='100%';
canvascurrentletter.style.height='100%';
function resizelettercanvas(){
    canvascurrentletter.width=canvascurrentletter.offsetWidth;
    canvascurrentletter.height=canvascurrentletter.offsetHeight;
    drawnninfo();
}
rightsidecontainer.appendChild(canvascurrentletter);
function drawnninfo(){
    if(nninfomodify.length>0){
        let input=nninfomodify[0];
        let arcs=nninfomodify[1];
        let points=nninfomodify[2];
        const x=points.x.filter(x=>Number.isFinite(x));
        const y=points.y.filter(y=>Number.isFinite(y));
        const xmin=Math.min(...x);
        const xmax=Math.max(...x);
        const ymin=Math.min(...y);
        const ymax=Math.max(...y);
        let ctx=canvascurrentletter.getContext('2d');
        ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);
        let s=1;
        let xt=-xmin+.05*(xmax-xmin);
        let yt=-ymin+.05*(ymax-ymin);
        if(ctx.canvas.width/ctx.canvas.height>input[0]){
            s=.9*(ctx.canvas.height)/(ymax-ymin);
        }else{
            s=.9*(ctx.canvas.width)/(xmax-xmin);
        }
        for(let ii=0;ii<arcs.length;ii++){
            ctx.fillStyle=`hsl(${Math.floor(Math.random()*360)}, ${70}%, ${60}%)`;
            ctx.beginPath();
            ctx.moveTo((arcs[ii].x[0]+xt)*s,(arcs[ii].y[0]+yt)*s);
            for(let i=1;i<arcs[ii].x.length;i++){
                if(Number.isFinite(arcs[ii].x[i])){
                    ctx.lineTo((arcs[ii].x[i]+xt)*s,(arcs[ii].y[i]+yt)*s);
                }else{
                    ctx.fill();
                    i++;
                    ctx.moveTo((arcs[ii].x[i]+xt)*s,(arcs[ii].y[i]+yt)*s);
                }
            }
            ctx.fill();
            ctx.fillStyle=`hsla(${Math.floor(Math.random()*360)}, ${100}%, ${8}%,${.3})`;
            ctx.beginPath();
            ctx.moveTo((arcs[ii].nx[0]+xt)*s,(arcs[ii].ny[0]+yt)*s);
            for(let i=1;i<arcs[ii].nx.length;i++){
                if(Number.isFinite(arcs[ii].nx[i])){
                    ctx.lineTo((arcs[ii].nx[i]+xt)*s,(arcs[ii].ny[i]+yt)*s);
                }else{
                    ctx.fill();
                    i++;
                    ctx.moveTo((arcs[ii].nx[i]+xt)*s,(arcs[ii].ny[i]+yt)*s);
                }
            }
            ctx.fill();
        }        
        ctx.strokeStyle = "black";
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo((points.x[0]+xt)*s,(points.y[0]+yt)*s);
        for(let i=1;i<points.x.length;i++){
            if(Number.isFinite(points.x[i])){
                ctx.lineTo((points.x[i]+xt)*s,(points.y[i]+yt)*s);
            }else{
                ctx.stroke();
                while(!Number.isFinite(points.x[++i])&&i<points.x.length){}
                ctx.moveTo((points.x[i]+xt)*s,(points.y[i]+yt)*s);
            }
        }
        ctx.stroke();
    }
}
// Load nn

// localStorage.removeItem("wb");
// localStorage.removeItem("trainingdata");
async function loadwb(){
    let wb=await compressedlocalstorage2obj('wb');
    if(wb===null){
        try{
            let response=await fetch('javascript/neuralnetwb.json');
            if (!response.ok){
                console.log(response.status);
            }
            const reader = await response.clone().body.getReader();
            const { value } = await reader.read();
            if (value[0] === 0x7B || value[1] === 0x5B) {
                wb=await response.json();
                await obj2compressedlocalstorage('wb',wb);
                // localStorage.setItem("wb",JSON.stringify(wb));
                // console.log("saved to local storage",wb);
            }else{
                const zipBlob = await response.blob();
                const stream=zipBlob.stream();
                const decompressedStream = stream.pipeThrough(new DecompressionStream('gzip'));
                const response2 = new Response(decompressedStream);
                const jsonText = await response2.text();
                await obj2compressedlocalstorage('wb',JSON.parse(jsonText));
                // localStorage.setItem("wb",jsonText);
            }
        }catch(error){
            console.log(error);
        }
    }
    let trainingdata=await compressedlocalstorage2obj('trainingdata');//localStorage.getItem('trainingdata');
    if(trainingdata===null){
        try{
            let response=await fetch('javascript/neuralnettraining.json');
            if (!response.ok){
                console.log(response.status);
            }
            const reader = await response.clone().body.getReader();
            const { value } = await reader.read();
            if (value[0] === 0x7B || value[1] === 0x5B) {
                trainingdata=await response.json();
                await obj2compressedlocalstorage('trainingdata',trainingdata);
                // localStorage.setItem("trainingdata",JSON.stringify(trainingdata));
            // console.log("saved to local storage",trainingdata);
            }else{
                const zipBlob = await response.blob();
                const stream=zipBlob.stream();
                const decompressedStream = stream.pipeThrough(new DecompressionStream('gzip'));
                const response2 = new Response(decompressedStream);
                const jsonText = await response2.text();
                await obj2compressedlocalstorage('trainingdata',JSON.parse(jsonText));
                // localStorage.setItem("trainingdata",jsonText);
            }
        }catch(error){
            console.log(error);
        }
    }
}
