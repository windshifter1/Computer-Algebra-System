const rprevbutton=document.createElement('button');
rprevbutton.textContent='previous';
rprevbutton.addEventListener('click',()=>{
    reviewi=mod(reviewi-1,beingreviewedletter.length);
    displayoneof.innerHTML=(reviewi+1)+" of "+beingreviewedletter.length;
    nninfomodify=getinputfornn(beingreviewedletter[reviewi][2]);
    drawnninfo();
});
const rnextbutton=document.createElement('button');
rnextbutton.textContent='next';
rnextbutton.addEventListener('click',()=>{
    reviewi=mod(reviewi+1,beingreviewedletter.length);
    displayoneof.innerHTML=(reviewi+1)+" of "+beingreviewedletter.length;
    nninfomodify=getinputfornn(beingreviewedletter[reviewi][2]);
    drawnninfo();
});
const rdelbutton=document.createElement('button');
rdelbutton.textContent='delete';
rdelbutton.addEventListener('click',async()=>{
    let trainingdata=await compressedlocalstorage2obj('trainingdata');//JSON.parse(localStorage.getItem('trainingdata'));
    for(let i=0;i<trainingdata.length;i++){
        if(trainingdata[i][1].length===beingreviewedletter[reviewi][1].length&&trainingdata[i][1].every((val, idx) => val === beingreviewedletter[reviewi][1][idx])){
            trainingdata.splice(i,1);
            beingreviewedletter.splice(reviewi,1);
            reviewi=mod(reviewi,beingreviewedletter.length);
            nninfomodify=getinputfornn(beingreviewedletter[reviewi][2]);
            drawnninfo();
            await obj2compressedlocalstorage("trainingdata",trainingdata);
            // localStorage.setItem("trainingdata",JSON.stringify(trainingdata));
            displayoneof.innerHTML=(reviewi+1)+" of "+beingreviewedletter.length;
            break
        }
    }
});
