                            for(let ii=change.length-1;ii>i;ii--){
                                if(Array.isArray(change[ii])&&change[ii][0]==='^'&&deepCompare(change[i][2],change[ii][2])){
                                    changed=true;
                                    if(testing&&changed){
                                        return changed
