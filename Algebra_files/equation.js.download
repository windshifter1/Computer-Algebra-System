                            for(let iv=change[iii].length-1;iv>(iii===i?ii:0);iv--){
                                if(Array.isArray(change[iii][iv])&&change[iii][iv][0]==='^'&&deepCompare(change[iii][iv][2],change[i][ii][2])){
                                    changed=true;
