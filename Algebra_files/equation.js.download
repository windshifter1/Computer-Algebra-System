            }
        }
        var newnode=deepCopy(node);
        if(Array.isArray(node)&&node[0]==='real'){
            newnode=['/',['+',deepCopy(node[1]),['conj',deepCopy(node[1])]],'2'];
        }
        var p=this.getparent(node);
        p===undefined?this.equation=newnode:p[p.indexOf(node)]=newnode;
