            }else if(Number(node[2])%2===1){
                var newnode=['*',['^',['+','1',['-',['^',['cos',deepCopy(node[1][1])],'2']]],((Number(node[2])-1)/2).toFixed(0)],deepCopy(node[1])];
            }
            var p=this.getparent(node);
