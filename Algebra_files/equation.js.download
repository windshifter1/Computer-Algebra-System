                    nodeproperty.x.push(x);
                    nodeproperty.y.push(0);
                    nodeproperty.w.push(charwidth[ii]);
                    nodeproperty.h.push(np.height);
                    nodeproperty.isvar.push(false);
                    nodeproperty.isop.push(false);
                    nodeproperty.isfunc.push(false);
