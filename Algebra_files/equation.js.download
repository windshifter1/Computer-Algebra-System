                    for(let k=0;k<=n;k+=2){
                        let t=['*',this.nchoosek(n,k).toFixed(0),['^',['cos',deepCopy(a)],(n-k).toFixed(0)],['^',['sin',deepCopy(a)],(k).toFixed(0)]];
                        newnode.push((-1)**((k)/2)>0?t:['-',t]);
                    }
                    break
                case 'tan':
                    var s=['+'];
                    for(let k=1;k<=n;k+=2){
                        let t=['*',this.nchoosek(n,k).toFixed(0),['^',['cos',deepCopy(a)],(n-k).toFixed(0)],['^',['sin',deepCopy(a)],(k).toFixed(0)]];
