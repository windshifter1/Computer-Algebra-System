                ctx.font = "italic "+this.fontsize+"px "+fontname;
                x+=charwidth[ii++];
            }
        }else if(p[0]==='+'){
            var charheight=[];
            for(let i=1;i<p.length;i++){
                if(Array.isArray(p[i])){
                    s+=this.printimage(p[i]);
                    let np=this.nodeproperties.get(p[i]);
                    charwidth.push(np.width);
                    charheight.push(np.height);
