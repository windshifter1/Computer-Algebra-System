                    this.updatepos(p[i],x,yy,1);
                    x+=charwidth[ii++];
                }else{
                    drawtext(nodeproperty,p[i],ctx,x,y,this.fontsize,fontname,true,false,false);
                    x+=charwidth[ii++];
