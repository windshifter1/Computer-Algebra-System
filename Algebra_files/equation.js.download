                    let np=this.nodeproperties.get(p[1]);
                    let yy=(totalheight-np.height)/2;
                    nodeproperty.char.push('(');
                    nodeproperty.font.push(np.height+"px "+fontname);
                    nodeproperty.x.push(x);
