//                             let dotbotheight=xymaxmin[mindbelowi][3]-xymaxmin[mindbelowi][2];
//                             if(mindabove<xdifi/2&&mindbelow<xdifi/2&&dottopwidth<xdifi/5&&dotbotwidth<xdifi/5&&dottopheight<xdifi/5&&dotbotheight<xdifi/5){
//                                 removeaspartofdivi.push(i,mindabovei,mindbelowi);
//                                 divs[divs.length]=[...letterskel[i],...letterskel[mindabovei],...letterskel[mindbelowi]];
//                             }
//                         }
//                     }
//                 }
//             }
//             removeaspartofdivi.sort((a,b)=>a-b);
//             for(let i=removeaspartofdivi.length-1;i>=0;i--){
//                 letterskel.splice(removeaspartofdivi[i],1);
//                 xymaxmin.splice(removeaspartofdivi[i],1);
//             }
//             for(let i=0;i<divs.length;i++){
//                 letterskel.push(divs[i]);
//             }
        }
        for(let i=0;i<letterskel.length;i++){
            for(let ii=0;ii<letterskel[i].length;ii++){
                for(let iii=0;iii<letterskel[i][ii].length-2;iii++){
                    let xd=letterskel[i][ii][iii+2][0]-letterskel[i][ii][iii][0];
                    let yd=letterskel[i][ii][iii+2][1]-letterskel[i][ii][iii][1];
                    let n=(xd**2+yd**2)**.5;
                    if(Math.abs((-yd*(letterskel[i][ii][iii+1][0]-letterskel[i][ii][iii][0])+xd*(letterskel[i][ii][iii+1][1]-letterskel[i][ii][iii][1]))/n)<.1){
                        letterskel[i][ii].splice(iii+1,1);
                        iii--;
                    }
                }
                for(let iii=0;iii<letterskel[i][ii].length;iii++){
                    for(let iv=0;iv<letterskel[i][ii][iii].length;iv++){
                        letterskel[i][ii][iii][iv]/=scale;
                    }
                }
            }
        }
        // let canvasscaled=new OffscreenCanvas(width,height);
        // canvasscaled.getContext('2d').putImageData(new ImageData(blackandwhite,width,height),0,0);
        // let canvasback=new OffscreenCanvas(processbox[2],processbox[3]);
        // canvasback.getContext('2d').imageSmoothingEnabled = true;
        // canvasback.getContext('2d').imageSmoothingQuality = 'high';
        canvasback.getContext('2d').drawImage(canvasscaled,0,0,width,height,0,0,processbox[2],processbox[3]);
        blackandwhite=canvasback.getContext('2d').getImageData(0,0,processbox[2],processbox[3]).data;
        self.postMessage({"status":"done","typed":e.data.typed,"letterskel":letterskel,"width":processbox[2],"height":processbox[3],"image":blackandwhite.buffer},[blackandwhite.buffer]);
    }
}



